<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:Automation.App.Converters"
             xmlns:fonts="clr-namespace:Automation.App.Assets.Fonts"
             xmlns:scoped="clr-namespace:Automation.App.Features.Scoped"
             mc:Ignorable="d" d:DesignWidth="320"
             d:DataContext="{d:DesignInstance Type=scoped:ScopedVmDesign, IsDesignTimeCreatable=True}"
             x:Class="Automation.App.Features.Scoped.Components.ElementHeader">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource LucideIcon}"
                   FontSize="24" Width="24" Height="24"
                   Foreground="{Binding Metadata.Color, Converter={x:Static converters:StringToBrush.Instance}}"
                   Text="{Binding Metadata, Converter={x:Static converters:ScopedTypeConverters.ToIcon}}" />
        <TextBlock Grid.Column="1" Margin="8,0,0,0" FontSize="16" FontWeight="SemiBold"
                   VerticalAlignment="Center" Text="{Binding Metadata.Name}" />
        <Border Grid.Column="2" Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                CornerRadius="10" Padding="6,2"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <TextBlock Text="{Binding Metadata.Type}" FontSize="12" />
        </Border>
        <ui:DropDownButton Grid.Column="3" Appearance="Secondary" Padding="6">
            <TextBlock Style="{StaticResource LucideIcon}" Text="{x:Static fonts:LucideIconFont.Settings}" />
            <ui:DropDownButton.Flyout>
                <ContextMenu>
                    <MenuItem Header="Edit" Command="{Binding EditCommand}">
                        <MenuItem.Icon>
                            <TextBlock Style="{StaticResource LucideIcon}" Text="{x:Static fonts:LucideIconFont.Pencil}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Delete">
                        <MenuItem.Icon>
                            <TextBlock Style="{StaticResource LucideIcon}" Text="{x:Static fonts:LucideIconFont.Trash}" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </ui:DropDownButton.Flyout>
        </ui:DropDownButton>
    </Grid>
</UserControl>
