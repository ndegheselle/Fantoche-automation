<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:Automation.App.Converters"
             xmlns:fonts="clr-namespace:Automation.App.Assets.Fonts"
             xmlns:scoped="clr-namespace:Automation.App.Features.Scoped"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=scoped:ScopedVmDesign, IsDesignTimeCreatable=True}"
             x:Class="Automation.App.Features.Scoped.Components.ElementLabel">
    <StackPanel Orientation="Horizontal">
        <TextBlock Style="{StaticResource LucideIcon}"
                   Foreground="{Binding Metadata.Color, Converter={x:Static converters:StringToBrush.Instance}}"
                   Text="{Binding Metadata, Converter={x:Static converters:ScopedTypeConverters.ToIcon}}" />
        <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{Binding Metadata.Name}" />
    </StackPanel>
</UserControl>
