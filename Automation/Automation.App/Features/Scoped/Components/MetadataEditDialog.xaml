<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:Automation.App.Converters"
             xmlns:inputs="clr-namespace:Automation.App.Components.Inputs"
             xmlns:fonts="clr-namespace:Automation.App.Assets.Fonts"
             xmlns:components="clr-namespace:Automation.App.Features.Scoped.Components"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=components:MetadataEditVm}"
             x:Name="Root"
             x:Class="Automation.App.Features.Scoped.Components.MetadataEditDialog">
    <StackPanel Margin="16" Width="320">
        <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource LucideIcon}" FontSize="20"
                       VerticalAlignment="Center"
                       Text="{Binding Type, Converter={x:Static converters:ScopedTypeConverters.ToIcon}}" />
            <TextBlock Margin="8,0,0,0" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Text="Edit metadata" />
            <Border Margin="8,0,0,0" VerticalAlignment="Center"
                    CornerRadius="10" Padding="6,2"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <TextBlock Text="{Binding Type}" FontSize="12" />
            </Border>
        </StackPanel>

        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <inputs:IconPicker SelectedIcon="{Binding SelectedIcon, Mode=TwoWay}"
                               IsReadOnly="{Binding IsReadOnly}" />

            <!-- Editable color: hex entry plus a live swatch (WPF has no stock ColorPicker). -->
            <Grid Grid.Column="1" Margin="4,0,0,0"
                  Visibility="{Binding IsReadOnly, Converter={x:Static converters:CommonConverters.InverseBoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="20" Height="20" VerticalAlignment="Center"
                        CornerRadius="4"
                        Background="{Binding SelectedColor, Converter={x:Static converters:StringToBrush.Instance}}" />
                <ui:TextBox Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                         PlaceholderText="#RRGGBB"
                         Text="{Binding SelectedColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <Border Grid.Column="1" Margin="4,0,0,0"
                    Visibility="{Binding IsReadOnly, Converter={x:Static converters:CommonConverters.BoolToVisibility}}"
                    BorderBrush="{DynamicResource BorderColor30}" BorderThickness="1"
                    CornerRadius="8"
                    Padding="6,4">
                <Grid VerticalAlignment="Center">
                    <!-- Explicit color set on the element. -->
                    <StackPanel Visibility="{Binding SelectedColor, Converter={x:Static converters:CommonConverters.NotNullToVisibility}}"
                                Orientation="Horizontal">
                        <Border Width="20" Height="20"
                                CornerRadius="4"
                                Background="{Binding SelectedColor, Converter={x:Static converters:StringToBrush.Instance}}" />
                        <TextBlock Margin="8,0,0,0" FontSize="12"
                                   Text="{Binding SelectedColor}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- No color: fall back to the theme foreground, like the icon does. -->
                    <StackPanel Visibility="{Binding SelectedColor, Converter={x:Static converters:CommonConverters.NullToVisibility}}"
                                Orientation="Horizontal">
                        <Border Width="20" Height="20"
                                CornerRadius="4"
                                Background="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Margin="8,0,0,0" FontSize="12"
                                   Foreground="{DynamicResource MutedColor}"
                                   Text="Default"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <ui:TextBox Margin="0,4,0,0"
                 PlaceholderText="Name"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                 IsReadOnly="{Binding IsReadOnly}" />

        <inputs:TagsSelector Margin="0,4,0,0" Tags="{Binding Tags}" PlaceholderText="Add a tag"
                             IsReadOnly="{Binding IsReadOnly}" />

        <StackPanel Margin="0,4,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Appearance="Secondary" Content="Cancel" Command="{Binding CancelCommand}" />
            <ui:Button Margin="8,0,0,0" Appearance="Primary" Content="Save" Command="{Binding ConfirmCommand}"
                       IsEnabled="{Binding IsReadOnly, Converter={x:Static converters:CommonConverters.InvertBool}}" />
        </StackPanel>
    </StackPanel>
</UserControl>
