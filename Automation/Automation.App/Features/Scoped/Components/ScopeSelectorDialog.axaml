<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
             xmlns:fonts="clr-namespace:Automation.App.Assets.Fonts"
             xmlns:behaviors="clr-namespace:Automation.App.Components.Behaviors"
             xmlns:components="clr-namespace:Automation.App.Features.Scoped.Components"
             x:DataType="components:ScopeSelectorVm"
             mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="420"
             x:Class="Automation.App.Features.Scoped.Components.ScopeSelectorDialog">
    <Design.DataContext>
        <components:ScopeSelectorVmDesign />
    </Design.DataContext>

    <Grid RowDefinitions="auto * auto" RowSpacing="8" Margin="16" Width="480" Height="420">

        <StackPanel Spacing="2">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="LucideIcon" VerticalAlignment="Center"
                           Text="{x:Static fonts:LucideIconFont.FolderOpen}" />
                <TextBlock Classes="h4" VerticalAlignment="Center" Text="Select a scope" />
            </StackPanel>
            <TextBlock Classes="Caption"
                       Foreground="{DynamicResource MutedColor}"
                       Text="Right-click to add or rename a scope. Click an empty area to add at the root." />
        </StackPanel>

        <!-- Transparent background so right-clicks on empty space are caught (to unselect / add a root scope). -->
        <Border x:Name="TreeContainer" Grid.Row="1"
                Background="Transparent"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="{DynamicResource MdCornerRadius}">
            <Border.ContextMenu>
                <ContextMenu x:DataType="components:ScopeSelectorVm">
                    <MenuItem Header="New scope" Command="{Binding AddScopeCommand}">
                        <MenuItem.Icon>
                            <TextBlock Classes="LucideIcon"
                                       Text="{x:Static fonts:LucideIconFont.FolderPlus}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Rename" Command="{Binding RenameScopeCommand}">
                        <MenuItem.Icon>
                            <TextBlock Classes="LucideIcon"
                                       Text="{x:Static fonts:LucideIconFont.Pencil}" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </Border.ContextMenu>

            <Panel>
                <ScrollViewer>
                    <TreeView x:Name="ScopeTree"
                              Background="Transparent"
                              ItemsSource="{Binding RootNodes}"
                              SelectedItem="{Binding SelectedNode, Mode=TwoWay}">
                        <TreeView.Styles>
                            <Style Selector="TreeViewItem" x:DataType="components:ScopeTreeNode">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            </Style>
                        </TreeView.Styles>
                        <TreeView.ItemTemplate>
                            <TreeDataTemplate DataType="components:ScopeTreeNode" ItemsSource="{Binding Children}">
                                <Grid MinWidth="300">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Classes="LucideIcon" VerticalAlignment="Center"
                                                   Text="{x:Static fonts:LucideIconFont.FolderOpen}" />

                                        <!-- Display label (hidden while editing) -->
                                        <TextBlock Text="{Binding Name}"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding !IsEditing}" />

                                        <!-- Inline rename box -->
                                        <TextBox Text="{Binding EditingName, Mode=TwoWay}"
                                                 IsVisible="{Binding IsEditing}"
                                                 behaviors:EditBoxAssist.FocusOnVisible="True"
                                                 MinWidth="160"
                                                 Padding="4,2"
                                                 VerticalAlignment="Center">
                                            <TextBox.KeyBindings>
                                                <KeyBinding Gesture="Enter" Command="{Binding CommitEditCommand}" />
                                                <KeyBinding Gesture="Escape" Command="{Binding CancelEditCommand}" />
                                            </TextBox.KeyBindings>
                                        </TextBox>
                                    </StackPanel>
                                </Grid>
                            </TreeDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </ScrollViewer>
                <shadui:BusyArea IsBusy="{Binding IsLoading}" />
            </Panel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Classes="Outline" Content="Cancel" Command="{Binding CancelCommand}" />
            <Button Classes="Primary" Content="Select" Command="{Binding ConfirmCommand}" />
        </StackPanel>

    </Grid>
</UserControl>
