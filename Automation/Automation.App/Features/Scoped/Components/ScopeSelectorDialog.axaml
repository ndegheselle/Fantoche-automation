<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
             xmlns:fonts="clr-namespace:Automation.App.Assets.Fonts"
             xmlns:components="clr-namespace:Automation.App.Features.Scoped.Components"
             x:DataType="components:ScopeSelectorVm"
             mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="420"
             x:Class="Automation.App.Features.Scoped.Components.ScopeSelectorDialog">
    <Design.DataContext>
        <components:ScopeSelectorVmDesign />
    </Design.DataContext>

    <Grid RowDefinitions="auto * auto auto" RowSpacing="8" Margin="16" Width="480" Height="420">

        <StackPanel Spacing="2">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="LucideIcon" VerticalAlignment="Center"
                           Text="{x:Static fonts:LucideIconFont.FolderOpen}" />
                <TextBlock Classes="h4" VerticalAlignment="Center" Text="Select a scope" />
            </StackPanel>
            <TextBlock Classes="Caption"
                       Foreground="{DynamicResource MutedColor}"
                       Text="Choose where the new tasks will be created." />
        </StackPanel>

        <Panel Grid.Row="1">
            <ScrollViewer>
                <TreeView x:Name="ScopeTree"
                          ItemsSource="{Binding RootNodes}"
                          SelectedItem="{Binding SelectedNode, Mode=TwoWay}">
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate DataType="components:ScopeTreeNode" ItemsSource="{Binding Children}">
                            <Grid ColumnDefinitions="* auto" MinWidth="300">

                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="LucideIcon" VerticalAlignment="Center"
                                               Text="{x:Static fonts:LucideIconFont.FolderOpen}" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Add child: default state -->
                                <Button Grid.Column="1"
                                        Classes="Icon"
                                        IsVisible="{Binding !IsCreatingChild}"
                                        Command="{Binding BeginAddChildCommand}"
                                        ToolTip.Tip="New child scope">
                                    <TextBlock Classes="LucideIcon"
                                               Text="{x:Static fonts:LucideIconFont.FolderPlus}" />
                                </Button>

                                <!-- Add child: inline creation form -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2"
                                            IsVisible="{Binding IsCreatingChild}">
                                    <TextBox Text="{Binding NewChildName, Mode=TwoWay}"
                                             PlaceholderText="Scope name"
                                             MinWidth="110" />
                                    <Button Classes="Icon" Padding="4"
                                            Command="{Binding ConfirmAddChildCommand}">
                                        <TextBlock Classes="LucideIcon"
                                                   Text="{x:Static fonts:LucideIconFont.Check}" />
                                    </Button>
                                    <Button Classes="Icon" Padding="4"
                                            Command="{Binding CancelAddChildCommand}">
                                        <TextBlock Classes="LucideIcon"
                                                   Text="{x:Static fonts:LucideIconFont.CircleX}" />
                                    </Button>
                                </StackPanel>

                            </Grid>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </ScrollViewer>
            <shadui:BusyArea IsBusy="{Binding IsLoading}" />
        </Panel>

        <!-- Root-level scope creation -->
        <Grid Grid.Row="2">
            <Button Classes="Outline"
                    IsVisible="{Binding !IsCreatingRootScope}"
                    Command="{Binding BeginAddRootScopeCommand}"
                    Content="New root scope">
                <shadui:ButtonAssist.Icon>
                    <TextBlock Classes="LucideIcon"
                               Text="{x:Static fonts:LucideIconFont.FolderPlus}" />
                </shadui:ButtonAssist.Icon>
            </Button>

            <StackPanel Orientation="Horizontal" Spacing="4"
                        IsVisible="{Binding IsCreatingRootScope}">
                <TextBox Text="{Binding NewRootScopeName, Mode=TwoWay}"
                         PlaceholderText="Scope name"
                         MinWidth="200" />
                <Button Classes="Ghost" Padding="6"
                        Command="{Binding ConfirmAddRootScopeCommand}">
                    <TextBlock Classes="LucideIcon" Text="{x:Static fonts:LucideIconFont.Check}" />
                </Button>
                <Button Classes="Ghost" Padding="6"
                        Command="{Binding CancelAddRootScopeCommand}">
                    <TextBlock Classes="LucideIcon" Text="{x:Static fonts:LucideIconFont.CircleX}" />
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Classes="Outline" Content="Cancel" Command="{Binding CancelCommand}" />
            <Button Classes="Primary" Content="Select" Command="{Binding ConfirmCommand}" />
        </StackPanel>

    </Grid>
</UserControl>
