<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fonts="clr-namespace:Automation.App.Assets.Fonts"
             xmlns:converters="clr-namespace:Automation.App.Converters"
             xmlns:behaviors="clr-namespace:Automation.App.Components.Behaviors"
             xmlns:busy="clr-namespace:Automation.App.Components"
             xmlns:components="clr-namespace:Automation.App.Features.Scoped.Components"
             mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="420"
             d:DataContext="{d:DesignInstance Type=components:ScopeSelectorVmDesign, IsDesignTimeCreatable=True}"
             x:Class="Automation.App.Features.Scoped.Components.ScopeSelectorDialog">

    <Grid Margin="16" Width="480" Height="420">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource LucideIcon}" VerticalAlignment="Center"
                           Text="{x:Static fonts:LucideIconFont.FolderOpen}" />
                <TextBlock Margin="8,0,0,0" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Text="Select a scope" />
            </StackPanel>
            <TextBlock Margin="0,2,0,0" FontSize="12"
                       Foreground="{DynamicResource MutedColor}"
                       Text="Right-click to add or rename a scope. Click an empty area to add at the root." />
        </StackPanel>

        <!-- Transparent background so right-clicks on empty space are caught (to unselect / add a root scope). -->
        <Border x:Name="TreeContainer" Grid.Row="1" Margin="0,8,0,0"
                Background="Transparent"
                BorderBrush="{DynamicResource BorderColor30}"
                BorderThickness="1"
                CornerRadius="6">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="New scope" Command="{Binding AddScopeCommand}">
                        <MenuItem.Icon>
                            <TextBlock Style="{StaticResource LucideIcon}"
                                       Text="{x:Static fonts:LucideIconFont.FolderPlus}" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Rename" Command="{Binding RenameScopeCommand}">
                        <MenuItem.Icon>
                            <TextBlock Style="{StaticResource LucideIcon}"
                                       Text="{x:Static fonts:LucideIconFont.Pencil}" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </Border.ContextMenu>

            <Grid>
                <ScrollViewer>
                    <TreeView x:Name="ScopeTree"
                              Background="Transparent" BorderThickness="0"
                              ItemsSource="{Binding RootNodes}"
                              SelectedItemChanged="OnTreeSelectedItemChanged">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type components:ScopeTreeNode}" ItemsSource="{Binding Children}">
                                <Grid MinWidth="300">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource LucideIcon}" VerticalAlignment="Center"
                                                   Text="{x:Static fonts:LucideIconFont.FolderOpen}" />

                                        <!-- Display label (hidden while editing) -->
                                        <TextBlock Margin="6,0,0,0" Text="{Binding Name}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsEditing, Converter={x:Static converters:CommonConverters.InverseBoolToVisibility}}" />

                                        <!-- Inline rename box -->
                                        <TextBox Margin="6,0,0,0" Text="{Binding EditingName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Visibility="{Binding IsEditing, Converter={x:Static converters:CommonConverters.BoolToVisibility}}"
                                                 behaviors:EditBoxAssist.FocusOnVisible="True"
                                                 MinWidth="160"
                                                 Padding="4,2"
                                                 VerticalAlignment="Center">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding CommitEditCommand}" />
                                                <KeyBinding Key="Escape" Command="{Binding CancelEditCommand}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </StackPanel>
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </ScrollViewer>
                <busy:BusyOverlay IsBusy="{Binding IsLoading}" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,8,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Appearance="Secondary" Content="Cancel" Command="{Binding CancelCommand}" />
            <ui:Button Margin="8,0,0,0" Appearance="Primary" Content="Select" Command="{Binding ConfirmCommand}" />
        </StackPanel>

    </Grid>
</UserControl>
