<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tasks="clr-namespace:Automation.App.Features.Scoped.Tasks"
             xmlns:components="clr-namespace:Automation.App.Features.Scoped.Components"
             xmlns:packagesComponents="clr-namespace:Automation.App.Features.Packages.Components"
             xmlns:history="clr-namespace:Automation.App.Features.History"
             x:DataType="tasks:TaskVm"
             x:Class="Automation.App.Features.Scoped.Tasks.TaskPage">
    <Grid Margin="4" RowSpacing="8" RowDefinitions="auto auto *">
        <components:ElementHeader />
        <packagesComponents:TaskTargetSummary Grid.Row="1" Target="{Binding Target, Mode=TwoWay}" />
        <Grid Grid.Row="2" RowDefinitions="auto *" RowSpacing="4">
            <TextBlock Classes="h4" Text="History" />
            <history:HistoryTable Grid.Row="1" DataContext="{Binding History}" />
        </Grid>
    </Grid>
</UserControl>
