<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:scopes="clr-namespace:Automation.App.Features.Scoped.Scopes"
             xmlns:components="clr-namespace:Automation.App.Features.Scoped.Components"
             xmlns:history="clr-namespace:Automation.App.Features.History"
             x:DataType="scopes:ScopeVm"
             x:Class="Automation.App.Features.Scoped.Scopes.ScopePage">
    <Grid Margin="4" RowSpacing="8" RowDefinitions="auto auto *">
        <components:ElementHeader />
        <TextBlock Grid.Row="1" Classes="Muted" Text="{Binding Children.Count, StringFormat='Contains {0} element(s).'}" />
        <Grid Grid.Row="2" RowDefinitions="auto *" RowSpacing="4">
            <TextBlock Classes="h4" Text="History" />
            <history:HistoryTable Grid.Row="1" DataContext="{Binding History}" />
        </Grid>
    </Grid>
</UserControl>
