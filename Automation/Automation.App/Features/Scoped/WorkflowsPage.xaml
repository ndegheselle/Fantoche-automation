<UserControl
    x:Class="Automation.App.Features.Scoped.WorkflowsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:busy="clr-namespace:Automation.App.Components"
    xmlns:components="clr-namespace:Automation.App.Features.Scoped.Components"
    xmlns:converters="clr-namespace:Automation.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fonts="clr-namespace:Automation.App.Assets.Fonts"
    xmlns:inputs="clr-namespace:Automation.App.Components.Inputs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:scoped="clr-namespace:Automation.Shared.Data.Scoped;assembly=Automation.Shared"
    xmlns:scopedUi="clr-namespace:Automation.App.Features.Scoped"
    xmlns:scopes="clr-namespace:Automation.App.Features.Scoped.Scopes"
    xmlns:tasks="clr-namespace:Automation.App.Features.Scoped.Tasks"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:workflows="clr-namespace:Automation.App.Features.Scoped.Workflows"
    d:DataContext="{d:DesignInstance Type=scopedUi:WorkflowsPageVm}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Margin="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" MinWidth="100" />
            <ColumnDefinition Width="2" />
            <ColumnDefinition Width="*" MinWidth="200" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <inputs:DebouncedSearch Grid.Column="0" Search="{Binding SearchText, Mode=TwoWay}" />
                <ui:DropDownButton
                    Grid.Column="1"
                    Margin="2,0,0,0"
                    VerticalAlignment="Stretch"
                    Appearance="Secondary"
                    ToolTip="Add a new element">
                    <TextBlock Style="{StaticResource LucideIcon}" Text="{x:Static fonts:LucideIconFont.Plus}" />
                    <ui:DropDownButton.Flyout>
                        <ContextMenu>
                            <MenuItem
                                Command="{Binding AddCommand}"
                                CommandParameter="{x:Static scoped:EnumScopedType.Scope}"
                                Header="Scope">
                                <MenuItem.Icon>
                                    <TextBlock Style="{StaticResource LucideIcon}" Text="{x:Static fonts:LucideIconFont.Folder}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem
                                Command="{Binding AddCommand}"
                                CommandParameter="{x:Static scoped:EnumScopedType.Workflow}"
                                Header="Workflow">
                                <MenuItem.Icon>
                                    <TextBlock Style="{StaticResource LucideIcon}" Text="{x:Static fonts:LucideIconFont.StickyNotes}" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem
                                Command="{Binding AddCommand}"
                                CommandParameter="{x:Static scoped:EnumScopedType.Task}"
                                Header="Task">
                                <MenuItem.Icon>
                                    <TextBlock Style="{StaticResource LucideIcon}" Text="{x:Static fonts:LucideIconFont.StickyNote}" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </ui:DropDownButton.Flyout>
                </ui:DropDownButton>
            </Grid>

            <Grid Grid.Row="1" Margin="0,2,0,0">
                <TreeView ItemsSource="{Binding Root.Children}" SelectedItemChanged="OnTreeSelectedItemChanged">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type scopes:ScopeVm}" ItemsSource="{Binding Children}">
                            <components:ElementLabel />
                        </HierarchicalDataTemplate>
                        <DataTemplate DataType="{x:Type workflows:WorkflowVm}">
                            <components:ElementLabel />
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type tasks:TaskVm}">
                            <components:ElementLabel />
                        </DataTemplate>
                    </TreeView.Resources>
                </TreeView>
                <busy:BusyOverlay IsBusy="{Binding IsLoading}" />
            </Grid>
        </Grid>
        <GridSplitter
            Grid.Column="1"
            Width="2"
            HorizontalAlignment="Stretch"
            Background="{DynamicResource GhostColor}" />
        <Grid Grid.Column="2">
            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{DynamicResource MutedColor}"
                Text="Select an element in the tree to display it."
                Visibility="{Binding Selected, Converter={x:Static converters:CommonConverters.NullToVisibility}}" />
            <ContentControl Content="{Binding Selected}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type scopes:ScopeVm}">
                        <scopes:ScopePage />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type workflows:WorkflowVm}">
                        <workflows:WorkflowPage />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type tasks:TaskVm}">
                        <tasks:TaskPage />
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Grid>
    </Grid>
</UserControl>
