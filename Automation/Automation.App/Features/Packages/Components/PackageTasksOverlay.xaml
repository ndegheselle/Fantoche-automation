<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:fonts="clr-namespace:Automation.App.Assets.Fonts"
             xmlns:converters="clr-namespace:Automation.App.Converters"
             xmlns:appComponents="clr-namespace:Automation.App.Components"
             xmlns:inputs="clr-namespace:Automation.App.Components.Inputs"
             xmlns:components="clr-namespace:Automation.App.Features.Packages.Components"
             d:DataContext="{d:DesignInstance Type=components:PackageTasksVm}"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             Background="{DynamicResource ApplicationBackgroundBrush}"
             x:Class="Automation.App.Features.Packages.Components.PackageTasksOverlay">
    <Grid Background="{DynamicResource CardBackgroundColor}">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource LucideIcon}" VerticalAlignment="Center"
                                   Text="{x:Static fonts:LucideIconFont.ListCheck}" />
                        <TextBlock FontSize="18" FontWeight="SemiBold" Margin="8,0,0,0"
                                   VerticalAlignment="Center" Text="Set up tasks" />
                    </StackPanel>
                    <TextBlock FontSize="12" Margin="0,2,0,0"
                               Foreground="{DynamicResource MutedColor}"
                               Text="Create tasks for new classes or update existing ones to the new version." />
                </StackPanel>
                <ui:Button Grid.Column="1"
                           Appearance="Transparent"
                           Command="{Binding BackCommand}"
                           Content="Back">
                    <ui:Button.Icon>
                        <appComponents:LucideIcon Glyph="{x:Static fonts:LucideIconFont.ArrowLeft}" />
                    </ui:Button.Icon>
                </ui:Button>
            </Grid>

            <ScrollViewer Grid.Row="1">
                <StackPanel>

                    <!-- Empty state -->
                    <Border Visibility="{Binding IsEmpty, Converter={x:Static converters:CommonConverters.BoolToVisibility}}"
                            BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource LucideIcon}"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                       VerticalAlignment="Center"
                                       Text="{x:Static fonts:LucideIconFont.AlertTriangle}" />
                            <TextBlock Text="This package has no task classes." Margin="8,0,0,0"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- New classes: create tasks -->
                    <StackPanel Margin="0,0,0,16"
                                Visibility="{Binding HasNewClasses, Converter={x:Static converters:CommonConverters.BoolToVisibility}}">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" Text="New classes" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Text="Create in" />
                            <inputs:ScopeSelectorInput Grid.Column="1"
                                                       SelectedScope="{Binding SelectedScope, Mode=TwoWay}" />
                        </Grid>

                        <DataGrid x:Name="NewClassesGrid"
                                  ItemsSource="{Binding NewClasses}"
                                  AutoGenerateColumns="False"
                                  CanUserReorderColumns="False"
                                  CanUserSortColumns="False"
                                  GridLinesVisibility="Horizontal"
                                  SelectionMode="Single">
                            <DataGrid.Columns>

                                <DataGridTemplateColumn Width="44" CanUserResize="False" CanUserSort="False">
                                    <DataGridTemplateColumn.Header>
                                        <CheckBox x:Name="NewClassesSelectToggler"
                                                  Command="{Binding DataContext.ToggleNewClassesSelectionCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                  CommandParameter="{Binding IsChecked, ElementName=NewClassesSelectToggler}"
                                                  IsChecked="{Binding DataContext.SelectAllNewClasses, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Class" Width="Auto"
                                                    IsReadOnly="True"
                                                    Binding="{Binding ClassFullName}" />
                                <DataGridTextColumn Header="Dll" Width="Auto"
                                                    IsReadOnly="True"
                                                    Binding="{Binding Dll}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>

                    <!-- Existing tasks: update to the new version -->
                    <StackPanel Margin="0,0,0,16"
                                Visibility="{Binding HasExistingTasks, Converter={x:Static converters:CommonConverters.BoolToVisibility}}">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" Text="Existing tasks" />

                        <DataGrid x:Name="ExistingTasksGrid"
                                  ItemsSource="{Binding ExistingTasks}"
                                  AutoGenerateColumns="False"
                                  CanUserReorderColumns="False"
                                  CanUserSortColumns="False"
                                  GridLinesVisibility="Horizontal"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="44" CanUserResize="False" CanUserSort="False">
                                    <DataGridTemplateColumn.Header>
                                        <CheckBox x:Name="ExistingTasksSelectToggler"
                                                  Command="{Binding DataContext.ToggleExistingTasksSelectionCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                  CommandParameter="{Binding IsChecked, ElementName=ExistingTasksSelectToggler}"
                                                  IsChecked="{Binding DataContext.SelectAllExistingTasks, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Task" Width="*"
                                                    IsReadOnly="True"
                                                    Binding="{Binding Name}" />
                                <DataGridTextColumn Header="Class" Width="*"
                                                    IsReadOnly="True"
                                                    Binding="{Binding ClassFullName}" />
                                <DataGridTemplateColumn Header="Version" Width="Auto" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type components:ExistingTaskRow}">
                                            <StackPanel Orientation="Horizontal"
                                                        VerticalAlignment="Center" Margin="8,0">
                                                <Border CornerRadius="10" Padding="6,2" VerticalAlignment="Center"
                                                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                                                    <TextBlock Text="{Binding CurrentVersion}" />
                                                </Border>
                                                <TextBlock Style="{StaticResource LucideIcon}" VerticalAlignment="Center" Margin="6,0"
                                                           Text="{x:Static fonts:LucideIconFont.ArrowRight}" />
                                                <Border CornerRadius="10" Padding="6,2" VerticalAlignment="Center"
                                                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                                                    <TextBlock Text="{Binding DataContext.TargetVersion, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>

                    <!-- Removed classes: tasks to remove -->
                    <StackPanel Visibility="{Binding HasRemovedClasses, Converter={x:Static converters:CommonConverters.BoolToVisibility}}">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" Text="Removed classes" />
                        <TextBlock FontSize="12" Margin="0,0,0,8"
                                   Foreground="{DynamicResource MutedColor}"
                                   Text="These tasks target classes that no longer exist in the new version. Selected tasks will be removed." />

                        <DataGrid x:Name="RemovedClassesGrid"
                                  ItemsSource="{Binding RemovedClasses}"
                                  AutoGenerateColumns="False"
                                  CanUserReorderColumns="False"
                                  CanUserSortColumns="False"
                                  GridLinesVisibility="Horizontal"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="44" CanUserResize="False" CanUserSort="False">
                                    <DataGridTemplateColumn.Header>
                                        <CheckBox x:Name="RemovedClassesSelectToggler"
                                                  Command="{Binding DataContext.ToggleRemovedClassesSelectionCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                  CommandParameter="{Binding IsChecked, ElementName=RemovedClassesSelectToggler}"
                                                  IsChecked="{Binding DataContext.SelectAllRemovedClasses, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Task" Width="*"
                                                    IsReadOnly="True"
                                                    Binding="{Binding Name}" />
                                <DataGridTextColumn Header="Class" Width="*"
                                                    IsReadOnly="True"
                                                    Binding="{Binding ClassFullName}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Appearance="Primary" Content="Apply" Command="{Binding ApplyCommand}"
                           Visibility="{Binding IsEmpty, Converter={x:Static converters:CommonConverters.InverseBoolToVisibility}}">
                    <ui:Button.Icon>
                        <appComponents:LucideIcon Glyph="{x:Static fonts:LucideIconFont.Check}" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>

        </Grid>
        <appComponents:BusyOverlay IsBusy="{Binding IsLoading}" />
    </Grid>
</UserControl>
