<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fonts="clr-namespace:Automation.App.Assets.Fonts"
             xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Name="Root"
             x:Class="Automation.App.Features.Packages.Components.TaskTargetSummary">
    <Panel MinHeight="80">
        <!-- No target: empty placeholder with a select action -->
        <Border IsVisible="{Binding Target, Converter={x:Static ObjectConverters.IsNull}, ElementName=Root}"
                BorderBrush="{DynamicResource WarningColor20}"
                BorderThickness="1"
                CornerRadius="{DynamicResource MdCornerRadius}">
            <StackPanel Spacing="4" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Classes="LucideIcon"
                               Foreground="{DynamicResource WarningColor}"
                               VerticalAlignment="Center"
                               Text="{x:Static fonts:LucideIconFont.AlertTriangle}" />
                    <TextBlock Text="No task target"
                               Foreground="{DynamicResource WarningColor60}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button Classes="Ghost" HorizontalAlignment="Center" Content="Select" Click="OnSelectClick">
                    <shadui:ButtonAssist.Icon>
                        <TextBlock
                            Classes="LucideIcon"
                            Text="{x:Static fonts:LucideIconFont.PackageOpen}" />
                    </shadui:ButtonAssist.Icon>
                </Button>
            </StackPanel>
        </Border>

        <!-- With target: summary and a remove action -->
        <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                CornerRadius="{StaticResource LgCornerRadius}" 
                Background="{DynamicResource CardBackgroundColor}"
                Padding="8"
                IsVisible="{Binding Target, Converter={x:Static ObjectConverters.IsNotNull}, ElementName=Root}">
            <Grid ColumnDefinitions="* auto">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="h4" Text="{Binding Target?.Package.Id, ElementName=Root}" />
                        <shadui:Badge Content="{Binding Target?.Package.Version, ElementName=Root}"
                                      VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Target.ClassFullName, ElementName=Root}" />
                </StackPanel>

                <Button Grid.Column="1"
                        VerticalAlignment="Center"
                        Classes="DestructiveIcon"
                        ToolTip.Tip="Remove target"
                        Click="OnRemoveClick">
                    <shadui:ButtonAssist.Icon>
                        <TextBlock
                            Classes="LucideIcon"
                            Margin="0,8"
                            Text="{x:Static fonts:LucideIconFont.Trash}" />
                    </shadui:ButtonAssist.Icon>
                </Button>
            </Grid>
        </Border>
    </Panel>
</UserControl>