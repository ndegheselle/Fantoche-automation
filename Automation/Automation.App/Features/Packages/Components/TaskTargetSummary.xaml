<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:fonts="clr-namespace:Automation.App.Assets.Fonts"
             xmlns:converters="clr-namespace:Automation.App.Converters"
             xmlns:components="clr-namespace:Automation.App.Components"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Name="Root"
             x:Class="Automation.App.Features.Packages.Components.TaskTargetSummary">
    <Grid MinHeight="80">
        <!-- No target: empty placeholder with a select action -->
        <Border Visibility="{Binding Target, ElementName=Root, Converter={x:Static converters:CommonConverters.NullToVisibility}}"
                BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource LucideIcon}"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               VerticalAlignment="Center"
                               Text="{x:Static fonts:LucideIconFont.AlertTriangle}" />
                    <TextBlock Text="No task target" Margin="8,0,0,0"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <ui:Button Appearance="Transparent" Margin="0,4,0,0" HorizontalAlignment="Center"
                           Content="Select" Click="OnSelectClick">
                    <ui:Button.Icon>
                        <components:LucideIcon Glyph="{x:Static fonts:LucideIconFont.PackageOpen}" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </Border>

        <!-- With target: summary and a remove action -->
        <Border BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                CornerRadius="8"
                Background="{DynamicResource CardBackgroundColor}"
                Padding="8"
                Visibility="{Binding Target, ElementName=Root, Converter={x:Static converters:CommonConverters.NotNullToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Target.Package.Id, ElementName=Root}" />
                        <Border CornerRadius="10" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <TextBlock Text="{Binding Target.Package.Version, ElementName=Root}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Target.ClassFullName, ElementName=Root}" />
                </StackPanel>

                <ui:Button Grid.Column="1"
                           VerticalAlignment="Center"
                           Appearance="Danger" Padding="6"
                           ToolTip="Remove target"
                           Click="OnRemoveClick">
                    <TextBlock Style="{StaticResource LucideIcon}"
                               Text="{x:Static fonts:LucideIconFont.Trash}" />
                </ui:Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
