<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:fonts="clr-namespace:Automation.App.Assets.Fonts"
             xmlns:converters="clr-namespace:Automation.App.Converters"
             xmlns:data="clr-namespace:Automation.App.Components.Data"
             xmlns:appComponents="clr-namespace:Automation.App.Components"
             xmlns:inputs="clr-namespace:Automation.App.Components.Inputs"
             xmlns:components="clr-namespace:Automation.App.Features.Packages.Components"
             xmlns:execution="clr-namespace:Automation.Shared.Data.Execution;assembly=Automation.Shared"
             d:DataContext="{d:DesignInstance Type=components:TaskTargetPickerVm}"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="520"
             x:Class="Automation.App.Features.Packages.Components.TaskTargetPickerDialog">
    <Grid Margin="16" Width="800" Height="520">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource LucideIcon}" VerticalAlignment="Center"
                           Text="{x:Static fonts:LucideIconFont.Package}" />
                <TextBlock FontSize="18" FontWeight="SemiBold" Margin="8,0,0,0"
                           VerticalAlignment="Center" Text="Select a task target" />
            </StackPanel>
            <TextBlock FontSize="12" Margin="0,2,0,0"
                       Foreground="{DynamicResource MutedColor}"
                       Text="Pick a package, then one of its classes." />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- Packages (master) -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <inputs:DebouncedSearch Grid.Row="0" Margin="0,0,0,4"
                                        Search="{Binding SearchText, Mode=TwoWay}" />

                <Grid Grid.Row="1" Margin="0,0,0,4">
                    <DataGrid
                        x:Name="PackagesList"
                        ItemsSource="{Binding Packages}"
                        SelectedItem="{Binding SelectedPackage, Mode=TwoWay}"
                        AutoGenerateColumns="False"
                        CanUserReorderColumns="False"
                        CanUserSortColumns="False"
                        GridLinesVisibility="Horizontal"
                        SelectionMode="Single"
                        IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Identifier" Width="*"
                                                Binding="{Binding Identifier.Id}" />
                            <DataGridTemplateColumn Header="Version">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type execution:PackageInfos}">
                                        <Border CornerRadius="10" Padding="6,2"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                                            <TextBlock Text="{Binding Identifier.Version}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <appComponents:BusyOverlay IsBusy="{Binding IsLoadingPackages}" />
                </Grid>

                <data:Pagination
                    Grid.Row="2"
                    Total="{Binding TotalItems}"
                    CurrentPage="{Binding CurrentPage, Mode=TwoWay}"
                    PageSize="{Binding PageSize, Mode=TwoWay}" />
            </Grid>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{DynamicResource GhostColor}" />

            <!-- Classes (detail) -->
            <Grid Grid.Column="2">
                <Border Visibility="{Binding HasSelectedPackage, Converter={x:Static converters:CommonConverters.InverseBoolToVisibility}}"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource LucideIcon}"
                                   Foreground="{DynamicResource MutedColor}"
                                   VerticalAlignment="Center"
                                   Text="{x:Static fonts:LucideIconFont.ArrowLeft}" />
                        <TextBlock Text="Select a package" Margin="8,0,0,0"
                                   Foreground="{DynamicResource MutedColor}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Visibility="{Binding IsClassesEmpty, Converter={x:Static converters:CommonConverters.BoolToVisibility}}"
                        BorderBrush="{DynamicResource SystemFillColorCautionBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource LucideIcon}"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   VerticalAlignment="Center"
                                   Text="{x:Static fonts:LucideIconFont.AlertTriangle}" />
                        <TextBlock Text="No classes" Margin="8,0,0,0"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <DataGrid
                    x:Name="ClassesList"
                    Visibility="{Binding HasSelectedPackage, Converter={x:Static converters:CommonConverters.BoolToVisibility}}"
                    ItemsSource="{Binding GroupedClasses}"
                    SelectedItem="{Binding SelectedClass, Mode=TwoWay}"
                    AutoGenerateColumns="False"
                    CanUserReorderColumns="False"
                    CanUserSortColumns="False"
                    GridLinesVisibility="Horizontal"
                    SelectionMode="Single"
                    IsReadOnly="True">

                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="4">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}"
                                                   Foreground="{DynamicResource MutedColor}" />
                                    </StackPanel>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </DataGrid.GroupStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Class" Width="*"
                                            Binding="{Binding ClassFullName}" />
                    </DataGrid.Columns>
                </DataGrid>

                <appComponents:BusyOverlay IsBusy="{Binding IsLoadingClasses}" />
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Appearance="Secondary" Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0" />
            <ui:Button Appearance="Primary" Content="Select" Command="{Binding ConfirmCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
