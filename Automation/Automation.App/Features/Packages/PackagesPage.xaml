<UserControl
    x:Class="Automation.App.Features.Packages.PackagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:javigation="clr-namespace:Joufflu.Navigation.Controls;assembly=Joufflu.Navigation"
    xmlns:jnputs="clr-namespace:Joufflu.Inputs.Controls;assembly=Joufflu.Inputs"
    xmlns:jonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Automation.App.Features.Packages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Margin="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}" joufflu:Spacing.Gap="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="3*" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource H1}">Packages</TextBlock>
        <Grid Grid.Row="1" joufflu:Spacing.Gap="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <jnputs:Search Grid.Row="0" />
            <DataGrid Grid.Row="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" />
                    <DataGridTextColumn Header="Version" />
                    <DataGridTextColumn Header="Description" />
                </DataGrid.Columns>
            </DataGrid>
            <javigation:Paging Grid.Row="2" />
        </Grid>
        <Border
            Grid.Row="2"
            BorderThickness="{DynamicResource {x:Static joufflu:Dimensions.BorderThickness}}"
            CornerRadius="{DynamicResource {x:Static joufflu:Dimensions.CornerRadius}}">
            <Border.BorderBrush>
                <DrawingBrush Viewport="0,0,8,8" ViewportUnits="Absolute" TileMode="Tile">
                    <DrawingBrush.Drawing>
                        <DrawingGroup>
                            <GeometryDrawing Brush="{DynamicResource {x:Static joufflu:Brushes.BorderBrush}}">
                                <GeometryDrawing.Geometry>
                                    <GeometryGroup>
                                        <RectangleGeometry Rect="0,0,50,50" />
                                        <RectangleGeometry Rect="50,50,50,50" />
                                    </GeometryGroup>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Border.BorderBrush>
            <StackPanel VerticalAlignment="Center" joufflu:Spacing.Gap="8">
                <jonts:FontIcon
                    joufflu:Sizing.Size="xl"
                    Opacity="0.5"
                    Text="{x:Static jonts:LucideFontIcons.Upload}" />
                <TextBlock HorizontalAlignment="Center">Drop here or</TextBlock>
                <Button HorizontalAlignment="Center" Style="{StaticResource SecondaryButton}">
                    <StackPanel Orientation="Horizontal">
                        <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Files}" />
                        <TextBlock Margin="4,0,0,0">Select files</TextBlock>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
