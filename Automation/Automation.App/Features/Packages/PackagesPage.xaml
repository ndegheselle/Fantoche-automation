<UserControl
    x:Class="Automation.App.Features.Packages.PackagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:javigation="clr-namespace:Joufflu.Navigation.Controls;assembly=Joufflu.Navigation"
    xmlns:jnputs="clr-namespace:Joufflu.Inputs.Controls;assembly=Joufflu.Inputs"
    xmlns:jonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Automation.App.Features.Packages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:PackagesViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Margin="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}" joufflu:Spacing.Gap="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="3*" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource H1}">Packages</TextBlock>
        <Grid Grid.Row="1" joufflu:Spacing.Gap="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <jnputs:Search Grid.Row="0" SearchChanged="Search_SearchChanged" />
            <DataGrid
                Grid.Row="1"
                AutoGenerateColumns="False"
                CanUserReorderColumns="False"
                IsReadOnly="True"
                ItemsSource="{Binding Result.Items}">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Identifier.Id}" Header="Id" />
                    <DataGridTextColumn Binding="{Binding Identifier.Version}" Header="Version" />
                    <DataGridTextColumn
                        MaxWidth="400"
                        Binding="{Binding Description}"
                        Header="Description" />
                    <DataGridTemplateColumn Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button
                                    HorizontalAlignment="Right"
                                    joufflu:Sizing.IsSquare="True"
                                    Command="{Binding ViewModel.OpenPackageCommand, RelativeSource={RelativeSource AncestorType={x:Type local:PackagesPage}}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource SecondaryButton}">
                                    <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.ArrowRight}" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <javigation:Paging Grid.Row="2" PagingChange="Paging_PagingChange" />
        </Grid>
        <Border
            x:Name="DropZone"
            Grid.Row="2"
            AllowDrop="True"
            Background="Transparent"
            BorderThickness="{DynamicResource {x:Static joufflu:Dimensions.BorderThickness}}"
            CornerRadius="{DynamicResource {x:Static joufflu:Dimensions.CornerRadius}}">
            <Border.BorderBrush>
                <DrawingBrush
                    TileMode="Tile"
                    Viewport="0,0,8,8"
                    ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <DrawingGroup>
                            <GeometryDrawing Brush="{DynamicResource {x:Static joufflu:Brushes.BorderBrush}}">
                                <GeometryDrawing.Geometry>
                                    <GeometryGroup>
                                        <RectangleGeometry Rect="0,0,50,50" />
                                        <RectangleGeometry Rect="50,50,50,50" />
                                    </GeometryGroup>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Border.BorderBrush>
            <StackPanel VerticalAlignment="Center" joufflu:Spacing.Gap="8">
                <jonts:FontIcon
                    joufflu:Sizing.Size="xl"
                    Opacity="0.5"
                    Text="{x:Static jonts:LucideFontIcons.Upload}" />
                <TextBlock HorizontalAlignment="Center">Drop here .nupkg or</TextBlock>
                <Button
                    HorizontalAlignment="Center"
                    Click="SelectFile"
                    Style="{StaticResource SecondaryButton}">
                    <StackPanel Orientation="Horizontal">
                        <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Files}" />
                        <TextBlock Margin="4,0,0,0">Select file</TextBlock>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
