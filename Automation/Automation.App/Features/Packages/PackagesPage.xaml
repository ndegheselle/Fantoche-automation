<UserControl x:Class="Automation.App.Features.Packages.PackagesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Joufflu.Controls;assembly=Joufflu"
             xmlns:fonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
             xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
             xmlns:local="clr-namespace:Automation.App.Features.Packages"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:PackagesViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="24" joufflu:Spacing.Gap="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid Grid.Row="0">
            <StackPanel joufflu:Spacing.Gap="2">
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="Packages" />
                <TextBlock Opacity="0.7" Text="Task packages available to the automation project." />
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                    Command="{Binding AddCommand}"
                    Style="{StaticResource Primary}"
                    joufflu:ControlProperties.Size="sm">
                <StackPanel Orientation="Horizontal" joufflu:Spacing.Gap="6">
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.PackagePlus}" />
                    <TextBlock Text="Add package" />
                </StackPanel>
            </Button>
        </Grid>

        <!--  Search  -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" joufflu:Spacing.Gap="8">
            <TextBox Width="280"
                     VerticalContentAlignment="Center"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <Button Command="{Binding SearchCommand}" Style="{StaticResource OutlineSecondary}">
                <StackPanel Orientation="Horizontal" joufflu:Spacing.Gap="6">
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Search}" />
                    <TextBlock Text="Search" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!--  Packages  -->
        <DataGrid Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  IsReadOnly="True"
                  ItemsSource="{Binding Packages}"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Width="*" Binding="{Binding Identifier.Id}" Header="Package" />
                <DataGridTextColumn Width="120" Binding="{Binding Identifier.Version}" Header="Version" />
                <DataGridTextColumn Width="2*" Binding="{Binding Description}" Header="Description" />
                <DataGridTemplateColumn Width="60">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Margin="2"
                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource SoftDanger}"
                                    ToolTip="Remove"
                                    joufflu:ControlProperties.IsSquare="True"
                                    joufflu:ControlProperties.Size="xs">
                                <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Trash2}" />
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
