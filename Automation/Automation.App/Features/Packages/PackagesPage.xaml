<UserControl
    x:Class="Automation.App.Features.Packages.PackagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:jinputs="clr-namespace:Joufflu.Inputs.Controls;assembly=Joufflu.Inputs"
    xmlns:jnavigation="clr-namespace:Joufflu.Navigation.Controls;assembly=Joufflu.Navigation"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Automation.App.Features.Packages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Margin="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}" joufflu:Spacing.Gap="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
            <RowDefinition Height="auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource H1}">Packages</TextBlock>
        <Grid Grid.Row="1" joufflu:Spacing.Gap="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <jinputs:Search Grid.Row="0" />
            <DataGrid Grid.Row="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" />
                    <DataGridTextColumn Header="Version" />
                    <DataGridTextColumn Header="Description" />
                </DataGrid.Columns>
            </DataGrid>
            <jnavigation:Paging Grid.Row="2" />
        </Grid>
        <Separator Grid.Row="2" />
        <Border
            Grid.Row="3"
            BorderBrush="{DynamicResource {x:Static joufflu:Brushes.BorderBrush}}"
            BorderThickness="2"
            CornerRadius="{DynamicResource {x:Static joufflu:Dimensions.CornerRadius}}">
            <StackPanel VerticalAlignment="Center">
                <fonts:FontIcon
                    joufflu:Sizing.Size="xl"
                    Opacity="0.5"
                    Text="{x:Static fonts:LucideFontIcons.Upload}" />
                <TextBlock HorizontalAlignment="Center">Choose a file or drop it here.</TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
