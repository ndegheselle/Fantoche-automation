<UserControl
    x:Class="Automation.App.Features.Packages.PackagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:javigation="clr-namespace:Joufflu.Navigation.Controls;assembly=Joufflu.Navigation"
    xmlns:jnputs="clr-namespace:Joufflu.Inputs.Controls;assembly=Joufflu.Inputs"
    xmlns:jonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Automation.App.Features.Packages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:PackagesViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Margin="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}" joufflu:Spacing.Gap="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="3*" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" joufflu:Spacing.Gap="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <jnputs:Search Grid.Row="0" SearchText="{Binding Search, Mode=TwoWay}" />
            <DataGrid
                Grid.Row="1"
                AutoGenerateColumns="False"
                CanUserReorderColumns="False"
                IsReadOnly="True"
                ItemsSource="{Binding Result.Items}">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Identifier.Id}" Header="Id" />
                    <DataGridTextColumn Binding="{Binding Identifier.Version}" Header="Version" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding Description}"
                        Header="Description" />
                    <DataGridTemplateColumn>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button
                                    joufflu:Sizing.IsSquare="True"
                                    joufflu:Sizing.Size="sm"
                                    Command="{Binding ViewModel.OpenPackageCommand, RelativeSource={RelativeSource AncestorType={x:Type local:PackagesPage}}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource SecondaryButton}">
                                    <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.ArrowRight}" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <javigation:Paging
                Grid.Row="2"
                Capacity="{Binding Capacity, Mode=TwoWay}"
                PageNumber="{Binding PageNumber, Mode=TwoWay}" />
        </Grid>
        <Border
            x:Name="DropZone"
            Grid.Row="1"
            joufflu:DropTarget.Command="{Binding DropFilesCommand}"
            AllowDrop="True"
            Background="Transparent"
            BorderThickness="{DynamicResource {x:Static joufflu:Dimensions.BorderThickness}}"
            CornerRadius="{DynamicResource {x:Static joufflu:Dimensions.CornerRadius}}">

            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush">
                        <Setter.Value>
                            <DrawingBrush
                                TileMode="Tile"
                                Viewport="0,0,8,8"
                                ViewportUnits="Absolute">
                                <DrawingBrush.Drawing>
                                    <DrawingGroup>
                                        <GeometryDrawing Brush="{DynamicResource {x:Static joufflu:Brushes.BorderBrush}}">
                                            <GeometryDrawing.Geometry>
                                                <GeometryGroup>
                                                    <RectangleGeometry Rect="0,0,50,50" />
                                                    <RectangleGeometry Rect="50,50,50,50" />
                                                </GeometryGroup>
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingGroup>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="joufflu:DropTarget.IsDragOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static joufflu:Brushes.PrimaryBrush}}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel VerticalAlignment="Center" joufflu:Spacing.Gap="8">
                <jonts:FontIcon
                    joufflu:Sizing.Size="xl"
                    Opacity="0.5"
                    Text="{x:Static jonts:LucideFontIcons.Upload}" />
                <TextBlock HorizontalAlignment="Center">Drop here .nupkg or</TextBlock>
                <Button
                    HorizontalAlignment="Center"
                    Click="SelectFile"
                    Style="{StaticResource SecondaryButton}">
                    <StackPanel Orientation="Horizontal">
                        <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Files}" />
                        <TextBlock Margin="4,0,0,0">Select file</TextBlock>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
