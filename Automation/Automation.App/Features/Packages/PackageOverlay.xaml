<UserControl
    x:Class="Automation.App.Features.Packages.PackageOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Automation.App.Features.Packages.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:jonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Automation.App.Features.Packages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:PackageViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid joufflu:Spacing.Gap="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition />
            <RowDefinition Height="auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <controls:PackageSummary DataContext="{Binding Package}" />

        <TextBlock Grid.Row="1" Style="{StaticResource Lead}">Versions</TextBlock>
        <DataGrid
            Grid.Row="2"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            ItemsSource="{Binding Versions}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding}"
                    Header="Version" />
                <DataGridTemplateColumn>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button
                                joufflu:Sizing.IsSquare="True"
                                joufflu:Sizing.Size="sm"
                                Command="{Binding ViewModel.RemoveVersionCommand, RelativeSource={RelativeSource AncestorType={x:Type local:PackageOverlay}}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource SoftDangerButton}">
                                <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Trash}" />
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Style="{StaticResource Lead}">Classes</TextBlock>
        <DataGrid
            Grid.Row="4"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            ItemsSource="{Binding Classes}">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding ClassFullName}" Header="Name" />
                <DataGridTextColumn Binding="{Binding Dll}" Header="Dll" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
