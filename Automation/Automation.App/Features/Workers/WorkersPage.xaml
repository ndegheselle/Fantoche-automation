<UserControl x:Class="Automation.App.Features.Workers.WorkersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Joufflu.Controls;assembly=Joufflu"
             xmlns:fonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
             xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
             xmlns:local="clr-namespace:Automation.App.Features.Workers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:WorkersViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="WorkerStateBadge" TargetType="{x:Type controls:Badge}">
            <Setter Property="Variant" Value="Default" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Available">
                    <Setter Property="Variant" Value="Success" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Working">
                    <Setter Property="Variant" Value="Info" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Updating">
                    <Setter Property="Variant" Value="Warning" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Down">
                    <Setter Property="Variant" Value="Danger" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24" joufflu:Spacing.Gap="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel joufflu:Spacing.Gap="2">
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="Workers" />
                <TextBlock Opacity="0.7" Text="Registered workers, their state and current load." />
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource OutlineSecondary}"
                    joufflu:ControlProperties.Size="sm">
                <StackPanel Orientation="Horizontal" joufflu:Spacing.Gap="6">
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.RefreshCw}" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
        </Grid>

        <DataGrid Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  IsReadOnly="True"
                  ItemsSource="{Binding Workers}"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="120" Header="State">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <controls:Badge Margin="4"
                                            HorizontalAlignment="Left"
                                            Content="{Binding State}"
                                            Style="{StaticResource WorkerStateBadge}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Width="*" Binding="{Binding Name}" Header="Name" />
                <DataGridTextColumn Width="*" Binding="{Binding MachineName}" Header="Machine" />
                <DataGridTextColumn Width="110" Binding="{Binding Load}" Header="Running" />
                <DataGridTextColumn Width="110" Binding="{Binding Queue}" Header="Queue" />
                <DataGridTextColumn Width="90" Binding="{Binding Version}" Header="Version" />
                <DataGridTextColumn Width="160"
                                    Binding="{Binding LastHeartbeat, StringFormat='{}{0:T}'}"
                                    Header="Last heartbeat" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
