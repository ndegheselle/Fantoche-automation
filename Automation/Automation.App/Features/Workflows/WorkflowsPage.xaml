<UserControl x:Class="Automation.App.Features.Workflows.WorkflowsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Joufflu.Controls;assembly=Joufflu"
             xmlns:fonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
             xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
             xmlns:local="clr-namespace:Automation.App.Features.Workflows"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:WorkflowsViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!--  Badge showing the scoped element type.  -->
        <Style x:Key="TypeBadge" TargetType="{x:Type controls:Badge}">
            <Setter Property="Variant" Value="Default" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Metadata.Type}" Value="Scope">
                    <Setter Property="Variant" Value="Secondary" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Metadata.Type}" Value="Workflow">
                    <Setter Property="Variant" Value="Primary" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Metadata.Type}" Value="Task">
                    <Setter Property="Variant" Value="Info" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  Icon reflecting the scoped element type.  -->
        <Style x:Key="TypeIcon" TargetType="{x:Type fonts:FontIcon}">
            <Setter Property="Text" Value="{x:Static fonts:LucideFontIcons.Box}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Metadata.Type}" Value="Scope">
                    <Setter Property="Text" Value="{x:Static fonts:LucideFontIcons.ListTree}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Metadata.Type}" Value="Workflow">
                    <Setter Property="Text" Value="{x:Static fonts:LucideFontIcons.Workflow}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Metadata.Type}" Value="Task">
                    <Setter Property="Text" Value="{x:Static fonts:LucideFontIcons.Play}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24" joufflu:Spacing.Gap="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid Grid.Row="0">
            <StackPanel joufflu:Spacing.Gap="2">
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="Workflows" />
                <TextBlock Opacity="0.7" Text="Browse the scopes, workflows and tasks of the project." />
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource OutlineSecondary}"
                    joufflu:ControlProperties.Size="sm">
                <StackPanel Orientation="Horizontal" joufflu:Spacing.Gap="6">
                    <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.RefreshCw}" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
        </Grid>

        <!--  Breadcrumb  -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Breadcrumb}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                Content="{Binding Name}"
                                Style="{StaticResource Ghost}"
                                joufflu:ControlProperties.Size="sm" />
                        <fonts:FontIcon Margin="2,0" VerticalAlignment="Center" Opacity="0.5"
                                        Text="{x:Static fonts:LucideFontIcons.ListChevronsUpDown}" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--  Children  -->
        <DataGrid Grid.Row="2"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  IsReadOnly="True"
                  ItemsSource="{Binding Elements}"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="*" Header="Name">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Margin="4,0" Orientation="Horizontal" joufflu:Spacing.Gap="8">
                                <fonts:FontIcon VerticalAlignment="Center" Style="{StaticResource TypeIcon}" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding Metadata.Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="130" Header="Type">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <controls:Badge Margin="4"
                                            HorizontalAlignment="Left"
                                            Content="{Binding Metadata.Type}"
                                            Style="{StaticResource TypeBadge}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Margin="2"
                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                    CommandParameter="{Binding}"
                                    Content="Open"
                                    Style="{StaticResource SoftSecondary}"
                                    joufflu:ControlProperties.Size="xs" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
