<UserControl
    x:Class="Automation.App.Features.Workflows.Editor.WorkflowEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Automation.App.Features.Workflows.Editor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:nodify="clr-namespace:Nodify;assembly=Nodify"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!--  Editor grid, drawn as two levels of lines following the viewport  -->
        <SolidColorBrush
            x:Key="EditorGridBrush"
            Opacity="0.8"
            Color="{DynamicResource {x:Static joufflu:Colors.Border100Color}}" />

        <GeometryDrawing
            x:Key="SmallGridGeometry"
            Brush="{StaticResource EditorGridBrush}"
            Geometry="M0,0 L0,1 0.03,1 0.03,0.03 1,0.03 1,0 Z" />

        <GeometryDrawing
            x:Key="LargeGridGeometry"
            Brush="{StaticResource EditorGridBrush}"
            Geometry="M0,0 L0,1 0.015,1 0.015,0.015 1,0.015 1,0 Z" />

        <DrawingBrush
            x:Key="SmallGridLinesDrawingBrush"
            Drawing="{StaticResource SmallGridGeometry}"
            Opacity="0.5"
            TileMode="Tile"
            Transform="{Binding ViewportTransform, ElementName=Editor}"
            Viewport="0 0 20 20"
            ViewportUnits="Absolute" />

        <DrawingBrush
            x:Key="LargeGridLinesDrawingBrush"
            Drawing="{StaticResource LargeGridGeometry}"
            TileMode="Tile"
            Transform="{Binding ViewportTransform, ElementName=Editor}"
            Viewport="0 0 100 100"
            ViewportUnits="Absolute" />
    </UserControl.Resources>
    <Border
        Background="{DynamicResource {x:Static joufflu:Brushes.BackgroundBrush}}"
        BorderBrush="{DynamicResource {x:Static joufflu:Brushes.BorderBrush}}"
        BorderThickness="{DynamicResource {x:Static joufflu:Dimensions.BorderThickness}}"
        ClipToBounds="True"
        CornerRadius="{DynamicResource {x:Static joufflu:Dimensions.CornerRadius}}">
        <!--  The editor background being the grid lines, the solid color comes from the container  -->
        <Grid>
            <nodify:NodifyEditor x:Name="Editor" Background="{StaticResource SmallGridLinesDrawingBrush}" />
            <Grid Panel.ZIndex="-2" Background="{StaticResource LargeGridLinesDrawingBrush}" />
            <local:EditorOverlay />
        </Grid>
    </Border>
</UserControl>
