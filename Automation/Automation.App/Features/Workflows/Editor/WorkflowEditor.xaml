<UserControl
    x:Class="Automation.App.Features.Workflows.Editor.WorkflowEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:jonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:jonverters="clr-namespace:Joufflu.Converters;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Automation.App.Features.Workflows.Editor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:nodify="clr-namespace:Nodify;assembly=Nodify"
    xmlns:viewModels="clr-namespace:Automation.App.Features.Workflows.Editor.ViewModels"
    d:DataContext="{d:DesignInstance Type=local:WorkflowEditorViewModel}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Automation.App;component/Features/Workflows/Controls/ScopedIcon.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Editor grid, drawn as two levels of lines following the viewport  -->
            <SolidColorBrush
                x:Key="EditorGridBrush"
                Opacity="0.8"
                Color="{DynamicResource {x:Static joufflu:Colors.Border100Color}}" />

            <GeometryDrawing
                x:Key="SmallGridGeometry"
                Brush="{StaticResource EditorGridBrush}"
                Geometry="M0,0 L0,1 0.03,1 0.03,0.03 1,0.03 1,0 Z" />

            <GeometryDrawing
                x:Key="LargeGridGeometry"
                Brush="{StaticResource EditorGridBrush}"
                Geometry="M0,0 L0,1 0.015,1 0.015,0.015 1,0.015 1,0 Z" />

            <DrawingBrush
                x:Key="SmallGridLinesDrawingBrush"
                Drawing="{StaticResource SmallGridGeometry}"
                Opacity="0.5"
                TileMode="Tile"
                Transform="{Binding ViewportTransform, ElementName=Editor}"
                Viewport="0 0 20 20"
                ViewportUnits="Absolute" />

            <DrawingBrush
                x:Key="LargeGridLinesDrawingBrush"
                Drawing="{StaticResource LargeGridGeometry}"
                TileMode="Tile"
                Transform="{Binding ViewportTransform, ElementName=Editor}"
                Viewport="0 0 100 100"
                ViewportUnits="Absolute" />

            <Style TargetType="{x:Type nodify:Node}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type nodify:Node}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>

                                <!--  Header  -->
                                <Border
                                    Background="{TemplateBinding HeaderBrush}"
                                    Style="{TemplateBinding HeaderContainerStyle}"
                                    Visibility="{TemplateBinding HasHeader,
                                                                 Converter={x:Static jonverters:VisibilityConverter.Default}}">
                                    <ContentPresenter ContentSource="Header" />
                                </Border>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="22" />
                                    </Grid.ColumnDefinitions>
                                    <!--  Data IN  -->
                                    <ItemsControl
                                        VerticalAlignment="Center"
                                        Focusable="False"
                                        ItemTemplate="{TemplateBinding InputConnectorTemplate}"
                                        ItemsSource="{TemplateBinding Input}" />

                                    <!--  Body  -->
                                    <Border Grid.Column="1" Style="{StaticResource Card}">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                    </Border>

                                    <!--  Data OUT  -->
                                    <ItemsControl
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Focusable="False"
                                        ItemTemplate="{TemplateBinding OutputConnectorTemplate}"
                                        ItemsSource="{TemplateBinding Output}" />
                                </Grid>

                                <!--  Footer  -->
                                <Border
                                    Grid.Row="2"
                                    HorizontalAlignment="Center"
                                    Background="Transparent"
                                    Style="{TemplateBinding FooterContainerStyle}"
                                    Visibility="{TemplateBinding HasFooter,
                                                                 Converter={x:Static jonverters:VisibilityConverter.Default}}">
                                    <ContentPresenter ContentSource="Footer" />
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>
    <!--  Drop target of the whole editor, the toolbars over it included, so a node can be dropped anywhere in it  -->
    <Border
        joufflu:DropTarget.Command="{Binding DropCommand, RelativeSource={RelativeSource AncestorType={x:Type local:WorkflowEditor}}}"
        Background="{DynamicResource {x:Static joufflu:Brushes.BackgroundBrush}}"
        BorderThickness="{DynamicResource {x:Static joufflu:Dimensions.BorderThickness}}"
        ClipToBounds="True"
        CornerRadius="{DynamicResource {x:Static joufflu:Dimensions.CornerRadius}}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static joufflu:Brushes.BorderBrush}}" />
                <Style.Triggers>
                    <!--  True only for a task or a workflow, what the editor refuses never lights the border up  -->
                    <Trigger Property="joufflu:DropTarget.IsDragOver" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static joufflu:Brushes.PrimaryBrush}}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <!--  The editor background being the grid lines, the solid color comes from the container  -->
        <Grid>
            <nodify:NodifyEditor
                x:Name="Editor"
                Background="{StaticResource SmallGridLinesDrawingBrush}"
                ConnectionCompletedCommand="{Binding ConnectionCompletedCommand}"
                Connections="{Binding Connections}"
                ItemsDragCompletedCommand="{Binding ItemsDragCompletedCommand}"
                ItemsDragStartedCommand="{Binding ItemsDragStartedCommand}"
                ItemsSource="{Binding Nodes}"
                SelectedItems="{Binding SelectedNodes}"
                ViewportLocation="{Binding ViewportLocation, Mode=TwoWay}"
                ViewportSize="{Binding ViewportSize, Mode=OneWayToSource}">
                <nodify:NodifyEditor.InputBindings>
                    <KeyBinding Key="Delete" Command="{Binding RemoveCommand}" />
                    <KeyBinding Command="{Binding History.UndoCommand}" Gesture="Ctrl+Z" />
                    <KeyBinding Command="{Binding History.RedoCommand}" Gesture="Ctrl+Y" />
                </nodify:NodifyEditor.InputBindings>

                <nodify:NodifyEditor.Resources>
                    <DataTemplate DataType="{x:Type viewModels:NodeViewModel}">
                        <nodify:Node
                            Footer="{Binding Name}"
                            Input="{Binding Inputs}"
                            Output="{Binding Outputs}">
                            <nodify:Node.InputBindings>
                                <!--  The editor holds the command, the node only knowing its own view model  -->
                                <MouseBinding
                                    Command="{Binding DataContext.OpenSettingsCommand, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}"
                                    CommandParameter="{Binding}"
                                    Gesture="LeftDoubleClick" />
                            </nodify:Node.InputBindings>
                            <nodify:Node.InputConnectorTemplate>
                                <DataTemplate DataType="{x:Type viewModels:ConnectorViewModel}">
                                    <nodify:NodeInput
                                        Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                        Header="{Binding Name}"
                                        IsConnected="{Binding IsConnected}"
                                        IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}" />
                                </DataTemplate>
                            </nodify:Node.InputConnectorTemplate>
                            <nodify:Node.OutputConnectorTemplate>
                                <DataTemplate DataType="{x:Type viewModels:ConnectorViewModel}">
                                    <nodify:NodeOutput
                                        Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                        Header="{Binding Name}"
                                        IsConnected="{Binding IsConnected}"
                                        IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}" />
                                </DataTemplate>
                            </nodify:Node.OutputConnectorTemplate>

                            <jonts:FontIcon
                                DataContext="{Binding Metadata}"
                                FontSize="{DynamicResource {x:Static joufflu:Dimensions.ControlFontSizeXl}}"
                                Style="{StaticResource ScopedIcon}" />
                        </nodify:Node>
                    </DataTemplate>
                </nodify:NodifyEditor.Resources>

                <nodify:NodifyEditor.ItemContainerStyle>
                    <Style BasedOn="{StaticResource {x:Type nodify:ItemContainer}}" TargetType="{x:Type nodify:ItemContainer}">
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        <Setter Property="Location" Value="{Binding Location, Mode=TwoWay}" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <!--  A running workflow can't be edited : the nodes stay where they are  -->
                        <Setter Property="IsDraggable" Value="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}" />
                    </Style>
                </nodify:NodifyEditor.ItemContainerStyle>

                <nodify:NodifyEditor.ConnectionTemplate>
                    <DataTemplate DataType="{x:Type viewModels:ConnectionViewModel}">
                        <nodify:Connection Source="{Binding Source.Anchor}" Target="{Binding Target.Anchor}" />
                    </DataTemplate>
                </nodify:NodifyEditor.ConnectionTemplate>
            </nodify:NodifyEditor>

            <Grid Panel.ZIndex="-2" Background="{StaticResource LargeGridLinesDrawingBrush}" />
            <local:EditorOverlay Editor="{Binding ElementName=Editor}" />
        </Grid>
    </Border>
</UserControl>
