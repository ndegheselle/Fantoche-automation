<UserControl
    x:Class="Automation.App.Features.Workflows.Editor.EditorOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:jonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Automation.App.Features.Workflows.Editor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Margin="{DynamicResource {x:Static joufflu:Dimensions.SpacingThickness}}">
        <!--  Editor tools  -->
        <Border
            Padding="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Style="{StaticResource Card}">
            <StackPanel joufflu:Spacing.Gap="4">
                <Button joufflu:Sizing.IsSquare="True" Style="{StaticResource GhostButton}" ToolTip="Zoom in">
                    <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Plus}" />
                </Button>
                <Button joufflu:Sizing.IsSquare="True" Style="{StaticResource GhostButton}" ToolTip="Adjust zoom">
                    <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Fullscreen}" />
                </Button>
                <Button joufflu:Sizing.IsSquare="True" Style="{StaticResource GhostButton}" ToolTip="Zoom out">
                    <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Minus}" />
                </Button>
                <Separator />
                <Button joufflu:Sizing.IsSquare="True"
                    Style="{StaticResource GhostButton}"
                    ToolTip="Undo">
                    <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Undo}" />
                </Button>
                <Button joufflu:Sizing.IsSquare="True"
                    Style="{StaticResource GhostButton}"
                    ToolTip="Redo">
                    <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Redo}" />
                </Button>
            </StackPanel>
        </Border>

        <!--  Viewport actions  -->

        <Border
            Padding="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Style="{StaticResource Card}">
            <StackPanel joufflu:Spacing.Gap="4" Orientation="Horizontal">
                <Button joufflu:Sizing.IsSquare="True" Style="{StaticResource GhostButton}" ToolTip="Add">
                    <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Plus}" />
                </Button>
                <Button joufflu:Sizing.IsSquare="True" Style="{StaticResource GhostButton}" ToolTip="Remove">
                    <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Trash}" />
                </Button>
                <Button joufflu:Sizing.IsSquare="True" Style="{StaticResource GhostButton}" ToolTip="Save">
                    <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Save}" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
