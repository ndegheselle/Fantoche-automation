<UserControl
    x:Class="Automation.App.Features.Workflows.Details.TaskDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Automation.App.Features.Packages.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:jonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Automation.App.Features.Workflows.Details"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:TaskDetailsViewModel}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <TabControl>
        <TabItem Header="Settings">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                
                <!--  Current package  -->
                <Grid VerticalAlignment="Top" Visibility="{Binding HasTarget, Converter={StaticResource BoolToVisibility}}">
                    <controls:PackageSummary DataContext="{Binding TargetPackage}" />
                    <Button
                        Margin="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        joufflu:Sizing.IsSquare="True"
                        joufflu:Sizing.Size="sm"
                        Command="{Binding RemovePackageCommand}"
                        Style="{StaticResource SoftDangerButton}"
                        ToolTip="Remove the package">
                        <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Trash}" />
                    </Button>
                </Grid>

                <!--  No package yet  -->
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    joufflu:Spacing.Gap="8">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasTarget}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <StackPanel Orientation="Horizontal">
                        <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.CircleSlash2}" />
                        <TextBlock Margin="8,0,0,0">No target, select a package to setup the task.</TextBlock>
                    </StackPanel>
                    <Button HorizontalAlignment="Center" Command="{Binding SelectPackageCommand}">
                        <StackPanel Orientation="Horizontal">
                            <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Package}" />
                            <TextBlock Margin="4,0,0,0">Select package</TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>



                <Grid Grid.Row="1">
                    <Button
                HorizontalAlignment="Left"
                Command="{Binding DeleteCommand}"
                Style="{StaticResource SoftDangerButton}">
                        <StackPanel Orientation="Horizontal">
                            <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Trash}" />
                            <TextBlock Margin="4,0,0,0">Delete</TextBlock>
                        </StackPanel>
                    </Button>
                    <Button
                HorizontalAlignment="Right"
                Command="{Binding SaveCommand}"
                Style="{StaticResource PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Save}" />
                            <TextBlock Margin="4,0,0,0">Save</TextBlock>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
