<UserControl
    x:Class="Automation.App.Features.Workflows.Details.Controls.InstanceDetailOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:jeedback="clr-namespace:Joufflu.Feedback.Controls;assembly=Joufflu.Feedback"
    xmlns:jonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:jonverters="clr-namespace:Joufflu.Converters;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Automation.App.Features.Workflows.Details.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:InstanceDetailViewModel}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Automation.App;component/Features/Workflows/Details/Controls/InstanceState.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  The values of an execution are read only, they are what it ran with  -->
            <Style
                x:Key="ValueTextBox"
                BasedOn="{StaticResource {x:Type TextBox}}"
                TargetType="TextBox">
                <Setter Property="AcceptsReturn" Value="True" />
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Width="720" joufflu:Spacing.Gap="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <!--  What ran, in which state and for how long  -->
        <Border Style="{StaticResource Card}">
            <Grid joufflu:Spacing.Gap="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <TextBlock FontWeight="Bold" Text="{Binding Instance.NodeName}" />
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" joufflu:Spacing.Gap="8" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Muted}" Text="{Binding Instance.CreatedAt}" />
                    <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.ArrowRight}" />
                    <TextBlock Style="{StaticResource Muted}" Text="{Binding Instance.FinishedAt}" />
                    <TextBlock Style="{StaticResource Muted}" Text="{Binding Duration}" />
                </StackPanel>

                <jeedback:Badge
                    joufflu:Sizing.Size="xs"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Content="{Binding Instance.State}"
                    Style="{StaticResource InstanceStateBadge}" />
            </Grid>
        </Border>

        <!--  What it ran with and what it produced  -->
        <Grid Grid.Row="1" joufflu:Spacing.Gap="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <TextBlock Style="{StaticResource Muted}" Text="Parameters" />
            <TextBox
                Grid.Row="1"
                Height="140"
                Style="{StaticResource ValueTextBox}"
                Text="{Binding ParametersJson, Mode=OneWay}" />

            <TextBlock
                Grid.Column="1"
                Style="{StaticResource Muted}"
                Text="Output" />
            <TextBox
                Grid.Row="1"
                Grid.Column="1"
                Height="140"
                Style="{StaticResource ValueTextBox}"
                Text="{Binding OutputJson, Mode=OneWay}" />
        </Grid>

        <!--  The nodes a workflow ran, each opening its own detail. Hidden for a simple task.  -->
        <Grid
            Grid.Row="2"
            joufflu:Spacing.Gap="4"
            Visibility="{Binding HasChildren, Converter={x:Static jonverters:VisibilityConverter.Default}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <TextBlock Style="{StaticResource Muted}" Text="Executed nodes" />
            <DataGrid
                joufflu:Sizing.Size="xs"
                Grid.Row="1"
                MinHeight="160"
                AutoGenerateColumns="False"
                CanUserReorderColumns="False"
                IsReadOnly="True"
                ItemsSource="{Binding Children}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding NodeName}"
                        Header="Name" />
                    <DataGridTemplateColumn Header="State">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <jeedback:Badge Style="{StaticResource InstanceStateBadge}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Binding="{Binding CreatedAt, StringFormat=\{0:T\}}" Header="Started" />
                    <DataGridTextColumn Binding="{Binding FinishedAt, StringFormat=\{0:T\}}" Header="Finished" />
                    <DataGridTemplateColumn>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!--  The row only knows its own instance, the command lives on the detail  -->
                                <Button
                                    joufflu:Sizing.IsSquare="True"
                                    Command="{Binding DataContext.OpenChildCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource GhostButton}"
                                    ToolTip="Detail of the execution">
                                    <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.ChevronRight}" />
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <StackPanel
            Grid.Row="3"
            HorizontalAlignment="Right"
            joufflu:Spacing.Gap="4"
            Orientation="Horizontal">
            <Button Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}">Refresh</Button>
            <Button Command="{Binding CloseCommand}" Style="{StaticResource PrimaryButton}">Close</Button>
        </StackPanel>
    </Grid>
</UserControl>
