<UserControl
    x:Class="Automation.App.Features.Workflows.Details.Controls.ScopedActions"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:jonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:jonverters="clr-namespace:Joufflu.Converters;assembly=Joufflu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <!--
        Save and delete of a scoped element, the same wherever an element is displayed. Bound on the
        details view model it is dropped into rather than on a DataContext of its own.
    -->
    <Grid>
        <Button
            HorizontalAlignment="Left"
            Command="{Binding DeleteCommand}"
            Style="{StaticResource SoftDangerButton}"
            Visibility="{Binding Metadata.IsReadOnly, Mode=OneTime, Converter={x:Static jonverters:VisibilityConverter.Default}, ConverterParameter=False}">
            <StackPanel Orientation="Horizontal">
                <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Trash}" />
                <TextBlock Margin="4,0,0,0">Delete</TextBlock>
            </StackPanel>
        </Button>
        <Button
            HorizontalAlignment="Right"
            Command="{Binding SaveCommand}"
            Style="{StaticResource PrimaryButton}">
            <StackPanel Orientation="Horizontal">
                <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Save}" />
                <TextBlock Margin="4,0,0,0">Save</TextBlock>
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
