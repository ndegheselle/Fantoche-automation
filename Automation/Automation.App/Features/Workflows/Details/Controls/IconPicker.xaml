<UserControl
    x:Class="Automation.App.Features.Workflows.Details.Controls.IconPicker"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:inputs="clr-namespace:Joufflu.Inputs.Controls;assembly=Joufflu.Inputs"
    xmlns:jonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ToggleButton
        inputs:Dropdown.CloseOnClick="True"
        joufflu:Sizing.IsSquare="True"
        ToolTip="Select an icon">
        <jonts:FontIcon Text="{Binding SelectedIcon, ElementName=Root, TargetNullValue={x:Static jonts:LucideFontIcons.ImageOff}}" />
        <inputs:Dropdown.Popup>
            <StackPanel
                x:Name="PopupContent"
                Width="260"
                joufflu:Spacing.Gap="4">
                <!--  Bound on Text rather than SearchText : the icons are already in memory, so
                      there is nothing to debounce and the grid can follow every keystroke.  -->
                <inputs:Search Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding FilteredIcons}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Margin="2"
                                    Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding Glyph}"
                                    joufflu:Sizing.IsSquare="True"
                                    ToolTip="{Binding Name}">
                                    <jonts:FontIcon Text="{Binding Glyph}" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </inputs:Dropdown.Popup>
    </ToggleButton>
</UserControl>
