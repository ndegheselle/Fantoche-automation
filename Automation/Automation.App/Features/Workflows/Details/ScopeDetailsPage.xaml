<UserControl
    x:Class="Automation.App.Features.Workflows.Details.ScopeDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Automation.App.Features.Workflows.Details.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Automation.App.Features.Workflows.Details"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:ScopeDetailsViewModel}"
    mc:Ignorable="d">
    <TabControl SelectedValue="{Binding CurrentTab, Mode=TwoWay}" SelectedValuePath="Tag">
        <TabItem Header="Settings" Tag="{x:Static local:EnumDetailTab.Settings}">
            <Grid joufflu:Spacing.Gap="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <controls:MetadataEditor DataContext="{Binding Metadata}" />

                <controls:ScopedActions Grid.Row="2" />
            </Grid>
        </TabItem>
        <TabItem Header="History" Tag="{x:Static local:EnumDetailTab.History}">
            <controls:HistoryTable DataContext="{Binding History}" />
        </TabItem>
    </TabControl>
</UserControl>
