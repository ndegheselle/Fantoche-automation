<UserControl
    x:Class="Automation.App.Features.Workflows.Details.WorkflowDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:editor="clr-namespace:Automation.App.Features.Workflows.Editor"
    xmlns:jonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Automation.App.Features.Workflows.Details"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:WorkflowDetailsViewModel}"
    mc:Ignorable="d">
    <TabControl>
        <TabItem Header="Settings">
            <Grid joufflu:Spacing.Gap="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Style="{StaticResource Muted}">Name</TextBlock>
                    <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Top" joufflu:Spacing.Gap="4">
                    <CheckBox IsChecked="{Binding Workflow.WorkflowSettings.IsStoringAllData}">Store all data</CheckBox>
                    <CheckBox IsChecked="{Binding Workflow.WorkflowSettings.StopAtFirstEnd}">Stop at first end</CheckBox>
                    <CheckBox IsChecked="{Binding Workflow.WorkflowSettings.StopIfAnyTaskFail}">Stop if any task fail</CheckBox>
                </StackPanel>

                <Grid Grid.Row="2">
                    <Button
                        HorizontalAlignment="Left"
                        Command="{Binding DeleteCommand}"
                        Style="{StaticResource SoftDangerButton}">
                        <StackPanel Orientation="Horizontal">
                            <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Trash}" />
                            <TextBlock Margin="4,0,0,0">Delete</TextBlock>
                        </StackPanel>
                    </Button>
                    <Button
                        HorizontalAlignment="Right"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Save}" />
                            <TextBlock Margin="4,0,0,0">Save</TextBlock>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </TabItem>
        <TabItem Header="History" IsEnabled="False" />
        <TabItem Header="Editor">
            <editor:WorkflowEditor />
        </TabItem>
    </TabControl>
</UserControl>
