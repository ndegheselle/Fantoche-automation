<UserControl
    x:Class="Automation.App.Features.Workflows.Details.WorkflowDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Automation.App.Features.Workflows.Details"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:WorkflowDetailsViewModel}"
    mc:Ignorable="d">
    <StackPanel joufflu:Spacing.Gap="8">
        <TextBlock Style="{StaticResource H1}" Text="{Binding Node.Name}" />
        <TextBlock Style="{StaticResource Muted}">Workflow</TextBlock>

        <TextBlock Style="{StaticResource H2}">Graph</TextBlock>
        <TextBlock Text="{Binding Workflow.Graph.Nodes.Count, StringFormat={}{0} tasks}" />
        <TextBlock Text="{Binding Workflow.Graph.Connections.Count, StringFormat={}{0} connections}" />

        <TextBlock Style="{StaticResource H2}">Settings</TextBlock>
        <CheckBox IsChecked="{Binding Workflow.WorkflowSettings.IsStoringAllData}" IsEnabled="False">Store all data</CheckBox>
        <CheckBox IsChecked="{Binding Workflow.WorkflowSettings.StopAtFirstEnd}" IsEnabled="False">Stop at first end</CheckBox>
        <CheckBox IsChecked="{Binding Workflow.WorkflowSettings.StopIfAnyTaskFail}" IsEnabled="False">Stop if any task fail</CheckBox>
    </StackPanel>
</UserControl>
