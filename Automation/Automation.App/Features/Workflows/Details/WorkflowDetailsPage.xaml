<UserControl
    x:Class="Automation.App.Features.Workflows.Details.WorkflowDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Automation.App.Features.Workflows.Details.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:editor="clr-namespace:Automation.App.Features.Workflows.Editor"
    xmlns:jonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:jonverters="clr-namespace:Joufflu.Converters;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Automation.App.Features.Workflows.Details"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:WorkflowDetailsViewModel}"
    mc:Ignorable="d">
    <TabControl SelectedValue="{Binding CurrentTab, Mode=TwoWay}" SelectedValuePath="Tag">
        <TabItem Header="Settings" Tag="{x:Static local:EnumDetailTab.Settings}">
            <Grid joufflu:Spacing.Gap="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <controls:MetadataEditor DataContext="{Binding Metadata}" />

                <StackPanel
                    Grid.Row="1"
                    VerticalAlignment="Top"
                    joufflu:Spacing.Gap="4">
                    <CheckBox IsChecked="{Binding StopAtFirstEnd}">Stop at first end</CheckBox>
                    <CheckBox IsChecked="{Binding StopIfAnyTaskFail}">Stop if any task fail</CheckBox>

                    <!--  What the workflow is started with : the one schema written by hand  -->
                    <TextBlock
                        Margin="0,8,0,0"
                        Style="{StaticResource Muted}"
                        Text="Input schema" />
                    <TextBox
                        Height="160"
                        Padding="4"
                        AcceptsReturn="True"
                        AcceptsTab="True"
                        FontFamily="Consolas"
                        HorizontalScrollBarVisibility="Auto"
                        Text="{Binding InputSchemaJson, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        VerticalContentAlignment="Top"
                        VerticalScrollBarVisibility="Auto" />

                    <TextBlock Style="{StaticResource Muted}" Text="Default values, handed over for what the caller doesn't give" />
                    <TextBox
                        Height="120"
                        Padding="4"
                        AcceptsReturn="True"
                        AcceptsTab="True"
                        FontFamily="Consolas"
                        HorizontalScrollBarVisibility="Auto"
                        IsEnabled="{Binding HasStart}"
                        Text="{Binding InputDefaultsJson, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        VerticalContentAlignment="Top"
                        VerticalScrollBarVisibility="Auto" />

                    <ItemsControl ItemsSource="{Binding InputErrors}" Visibility="{Binding HasInputErrors, Converter={x:Static jonverters:VisibilityConverter.Default}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <jonts:FontIcon Foreground="{DynamicResource {x:Static joufflu:Brushes.DangerBrush}}" Text="{x:Static jonts:LucideFontIcons.AlertCircle}" />
                                    <TextBlock
                                        Margin="4,0,0,0"
                                        Foreground="{DynamicResource {x:Static joufflu:Brushes.DangerBrush}}"
                                        Text="{Binding}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Grid Grid.Row="2">
                    <Button
                        HorizontalAlignment="Left"
                        Command="{Binding DeleteCommand}"
                        Style="{StaticResource SoftDangerButton}"
                        Visibility="{Binding Metadata.IsReadOnly, Mode=OneTime, Converter={x:Static jonverters:VisibilityConverter.Default}, ConverterParameter=False}">
                        <StackPanel Orientation="Horizontal">
                            <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Trash}" />
                            <TextBlock Margin="4,0,0,0">Delete</TextBlock>
                        </StackPanel>
                    </Button>
                    <Button
                        HorizontalAlignment="Right"
                        Command="{Binding SaveCommand}"
                        Style="{StaticResource PrimaryButton}">
                        <StackPanel Orientation="Horizontal">
                            <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Save}" />
                            <TextBlock Margin="4,0,0,0">Save</TextBlock>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </TabItem>
        <TabItem Header="History" Tag="{x:Static local:EnumDetailTab.History}">
            <controls:HistoryTable DataContext="{Binding History}" />
        </TabItem>
        <TabItem Header="Usages" Tag="{x:Static local:EnumDetailTab.Usages}">
            <controls:UsagesTable DataContext="{Binding Usages}" />
        </TabItem>
        <TabItem Header="Editor" Tag="{x:Static local:EnumDetailTab.Editor}">
            <editor:WorkflowEditor DataContext="{Binding Editor}" />
        </TabItem>
    </TabControl>
</UserControl>
