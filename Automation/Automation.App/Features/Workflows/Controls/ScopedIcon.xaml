<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Automation.App.Converters"
    xmlns:jonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:scoped="clr-namespace:Automation.Shared.Data.Scoped;assembly=Automation.Shared">
    <Style
        x:Key="ScopedMetadataIcon"
        BasedOn="{StaticResource {x:Type jonts:FontIcon}}"
        TargetType="{x:Type jonts:FontIcon}">
        <Setter Property="Text" Value="{x:Static jonts:LucideFontIcons.FolderClosed}" />
        <Style.Triggers>
            <!--  Type of the metadata.  -->
            <DataTrigger Binding="{Binding Type}" Value="{x:Static scoped:EnumScopedType.Workflow}">
                <Setter Property="Text" Value="{x:Static jonts:LucideFontIcons.Workflow}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Type}" Value="{x:Static scoped:EnumScopedType.Task}">
                <Setter Property="Text" Value="{x:Static jonts:LucideFontIcons.SquareTerminal}" />
            </DataTrigger>

            <!--
                Customization of the metadata, declared last so it takes precedence over the icon of
                the type. The foreground is only set when a color was picked, to keep the inherited
                one (and its theming) otherwise.
            -->
            <DataTrigger Binding="{Binding Icon, Converter={x:Static converters:HasValueConverter.Default}}" Value="True">
                <Setter Property="Text" Value="{Binding Icon}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Color, Converter={x:Static converters:HasValueConverter.Default}}" Value="True">
                <Setter Property="Foreground" Value="{Binding Color}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style
        x:Key="ScopedIcon"
        BasedOn="{StaticResource {x:Type jonts:FontIcon}}"
        TargetType="{x:Type jonts:FontIcon}">
        <Setter Property="Text" Value="{x:Static jonts:LucideFontIcons.FolderClosed}" />
        <Style.Triggers>
            <!--  Type alone as DataContext.  -->
            <DataTrigger Binding="{Binding FallbackValue={x:Null}}" Value="{x:Static scoped:EnumScopedType.Workflow}">
                <Setter Property="Text" Value="{x:Static jonts:LucideFontIcons.Workflow}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding FallbackValue={x:Null}}" Value="{x:Static scoped:EnumScopedType.Task}">
                <Setter Property="Text" Value="{x:Static jonts:LucideFontIcons.SquareTerminal}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
