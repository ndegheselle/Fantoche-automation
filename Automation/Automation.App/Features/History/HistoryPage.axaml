<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:history="clr-namespace:Automation.App.Features.History"
             x:DataType="history:HistoryPageVm"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="450"
             x:Class="Automation.App.Features.History.HistoryPage">
    <Design.DataContext>
        <history:HistoryPageVMDesign />
    </Design.DataContext>
    <history:HistoryTable Margin="4" />
</UserControl>
