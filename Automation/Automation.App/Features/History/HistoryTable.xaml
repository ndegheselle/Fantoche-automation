<UserControl x:Class="Automation.App.Features.History.HistoryTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:data="clr-namespace:Automation.App.Components.Data"
             xmlns:components="clr-namespace:Automation.App.Components"
             xmlns:history="clr-namespace:Automation.App.Features.History"
             xmlns:execution="clr-namespace:Automation.Shared.Data.Execution;assembly=Automation.Shared"
             xmlns:fonts="clr-namespace:Automation.App.Assets.Fonts"
             mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="450"
             d:DataContext="{d:DesignInstance Type=history:HistoryVmBase}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <DataGrid
                x:Name="HistoryList"
                ItemsSource="{Binding Items}"
                AutoGenerateColumns="False"
                CanUserReorderColumns="False"
                CanUserSortColumns="False"
                GridLinesVisibility="Horizontal"
                SelectionMode="Single"
                IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Task" Width="*"
                                        Binding="{Binding NodeName}" />
                    <DataGridTemplateColumn Header="State">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type execution:TaskInstance}">
                                <Border CornerRadius="10" Padding="6,2"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                                    <Border.Resources>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding State}" Value="{x:Static execution:EnumTaskState.Pending}">
                                                    <Setter Property="Background" Value="{DynamicResource SecondaryColor}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="{x:Static execution:EnumTaskState.Waiting}">
                                                    <Setter Property="Background" Value="{DynamicResource SecondaryColor}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="{x:Static execution:EnumTaskState.Progressing}">
                                                    <Setter Property="Background" Value="{DynamicResource InfoColor}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="{x:Static execution:EnumTaskState.Completed}">
                                                    <Setter Property="Background" Value="{DynamicResource SuccessColor}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="{x:Static execution:EnumTaskState.Failed}">
                                                    <Setter Property="Background" Value="{DynamicResource ErrorColor}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding State}" Value="{x:Static execution:EnumTaskState.Canceled}">
                                                    <Setter Property="Background" Value="{DynamicResource WarningColor}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Resources>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource LucideIcon}"
                                                   FontSize="12"
                                                   Width="13" Height="13"
                                                   Margin="0,0,2,0"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Resources>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource LucideIcon}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="{x:Static execution:EnumTaskState.Pending}">
                                                            <Setter Property="Text" Value="{x:Static fonts:LucideIconFont.CircleDashed}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="{x:Static execution:EnumTaskState.Waiting}">
                                                            <Setter Property="Text" Value="{x:Static fonts:LucideIconFont.CirclePause}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="{x:Static execution:EnumTaskState.Progressing}">
                                                            <Setter Property="Text" Value="{x:Static fonts:LucideIconFont.CircleFadingArrowUp}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="{x:Static execution:EnumTaskState.Completed}">
                                                            <Setter Property="Text" Value="{x:Static fonts:LucideIconFont.CheckCircle}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="{x:Static execution:EnumTaskState.Failed}">
                                                            <Setter Property="Text" Value="{x:Static fonts:LucideIconFont.CircleX}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="{x:Static execution:EnumTaskState.Canceled}">
                                                            <Setter Property="Text" Value="{x:Static fonts:LucideIconFont.CircleSlash}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Resources>
                                        </TextBlock>
                                        <TextBlock Text="{Binding State}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Started"
                                        Binding="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" />
                    <DataGridTextColumn Header="Finished"
                                        Binding="{Binding FinishedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" />
                </DataGrid.Columns>
            </DataGrid>
            <components:BusyOverlay IsBusy="{Binding IsLoading}" />
        </Grid>

        <data:Pagination
            Grid.Row="1"
            Margin="0,4,0,0"
            Total="{Binding TotalItems}"
            CurrentPage="{Binding CurrentPage, Mode=TwoWay}"
            PageSize="{Binding PageSize, Mode=TwoWay}" />
    </Grid>
</UserControl>
