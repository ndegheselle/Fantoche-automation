<Application
    x:Class="Automation.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:home="clr-namespace:Automation.App.Features.Home"
    xmlns:jonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Automation.App"
    xmlns:packages="clr-namespace:Automation.App.Features.Packages"
    xmlns:packagesControls="clr-namespace:Automation.App.Features.Packages.Controls"
    xmlns:servers="clr-namespace:Automation.App.Features.Servers"
    xmlns:storage="clr-namespace:Automation.App.Features.Storage"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    xmlns:workflows="clr-namespace:Automation.App.Features.Workflows"
    xmlns:workflowsControls="clr-namespace:Automation.App.Features.Workflows.Controls"
    xmlns:workflowsDetails="clr-namespace:Automation.App.Features.Workflows.Details"
    xmlns:workflowsDetailsControls="clr-namespace:Automation.App.Features.Workflows.Details.Controls"
    xmlns:workflowsEditor="clr-namespace:Automation.App.Features.Workflows.Editor">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Joufflu;component/Resources.xaml" />
                <ResourceDictionary Source="Resources/Nodify.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <system:Double x:Key="{x:Static joufflu:Dimensions.Spacing}">6</system:Double>
            <Thickness x:Key="{x:Static joufflu:Dimensions.SpacingThickness}">6</Thickness>

            <DataTemplate DataType="{x:Type home:HomeViewModel}">
                <home:HomePage />
            </DataTemplate>

            <DataTemplate DataType="{x:Type workflows:WorkflowsViewModel}">
                <workflows:WorkflowsPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type workflowsControls:TaskSelectionViewModel}">
                <workflowsControls:TaskSelectionOverlay />
            </DataTemplate>
            <DataTemplate DataType="{x:Type workflowsEditor:TaskSettingsViewModel}">
                <workflowsEditor:TaskSettingsOverlay />
            </DataTemplate>
            <DataTemplate DataType="{x:Type workflowsEditor:StartSettingsViewModel}">
                <workflowsEditor:StartSettingsOverlay />
            </DataTemplate>
            <DataTemplate DataType="{x:Type workflowsDetailsControls:InstanceDetailViewModel}">
                <workflowsDetailsControls:InstanceDetailOverlay />
            </DataTemplate>

            <DataTemplate DataType="{x:Type packages:PackagesViewModel}">
                <packages:PackagesPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type packages:PackageViewModel}">
                <packages:PackageOverlay />
            </DataTemplate>
            <DataTemplate DataType="{x:Type packagesControls:PackageSelectionViewModel}">
                <packagesControls:PackageSelectionOverlay />
            </DataTemplate>

            <DataTemplate DataType="{x:Type servers:ServersViewModel}">
                <servers:ServersPage />
            </DataTemplate>

            <DataTemplate DataType="{x:Type storage:StorageViewModel}">
                <storage:StoragePage />
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>
