<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Automation.App;component/Components/Inputs/TagsSelector.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Lucide icon font (embedded as a WPF Resource). Family name is "lucide". -->
    <FontFamily x:Key="LucideIconFamily">/Automation.App;component/Assets/Fonts/#lucide</FontFamily>

    <!-- Applied to TextBlocks used as Lucide glyph icons (replaces the Avalonia Classes="LucideIcon"). -->
    <Style x:Key="LucideIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource LucideIconFamily}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
        Aliases for the brush keys carried over from the Avalonia/ShadUI views. Tuned for the dark
        theme (the app's default). Refine per-theme later if needed.
    -->
    <SolidColorBrush x:Key="MutedColor" Color="#9AA0A6" />
    <SolidColorBrush x:Key="BorderColor30" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="BorderColor" Color="#52FFFFFF" />
    <SolidColorBrush x:Key="GhostColor" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundColor" Color="#1E1E1E" />

    <!-- Accent + semantic status colors (carried over from the ShadUI palette). -->
    <SolidColorBrush x:Key="PrimaryColor" Color="#3B82F6" />
    <SolidColorBrush x:Key="SecondaryColor" Color="#6B7280" />
    <SolidColorBrush x:Key="InfoColor" Color="#3B82F6" />
    <SolidColorBrush x:Key="SuccessColor" Color="#22C55E" />
    <SolidColorBrush x:Key="WarningColor" Color="#F59E0B" />
    <SolidColorBrush x:Key="ErrorColor" Color="#EF4444" />

</ResourceDictionary>
