<UserControl x:Class="Automation.App.Components.Inputs.IconPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="60"
             xmlns:converters="clr-namespace:Automation.App.Converters"
             x:Name="Root">
    <Grid>
        <ui:Button x:Name="TriggerButton"
                   Appearance="Secondary"
                   Padding="6"
                   BorderBrush="{DynamicResource BorderColor}"
                   BorderThickness="1"
                   IsEnabled="{Binding IsReadOnly, ElementName=Root, Converter={x:Static converters:CommonConverters.InvertBool}}"
                   Click="OnTriggerClick">
            <TextBlock Style="{StaticResource LucideIcon}"
                       Text="{Binding SelectedIcon, ElementName=Root}" />
        </ui:Button>
        <Popup x:Name="PickerPopup"
               PlacementTarget="{Binding ElementName=TriggerButton}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True">
            <Border Background="{DynamicResource ApplicationBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid Width="280" Height="320" Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ui:TextBox x:Name="SearchBox" Grid.Row="0"
                             Margin="0,0,0,4"
                             PlaceholderText="Search icons..."
                             TextChanged="OnSearchChanged" />
                    <Grid Grid.Row="1">
                        <TextBlock x:Name="EmptyPlaceholder"
                                   Foreground="{DynamicResource MutedColor}"
                                   Text="No icons found"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="IconList"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="34" Height="34"
                                                Background="Transparent"
                                                Cursor="Hand"
                                                MouseLeftButtonUp="OnIconTapped">
                                            <TextBlock Style="{StaticResource LucideIcon}"
                                                       Text="{Binding Glyph}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
