<ui:TextBox
    x:Class="Automation.App.Components.Inputs.DebouncedSearch"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:Automation.App.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fonts="clr-namespace:Automation.App.Assets.Fonts"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    HorizontalAlignment="Stretch"
    d:DesignHeight="40"
    d:DesignWidth="800"
    ClearButtonEnabled="True"
    PlaceholderText="Search..."
    Style="{StaticResource {x:Type ui:TextBox}}"
    mc:Ignorable="d">
    <ui:TextBox.Icon>
        <components:LucideIcon Glyph="{x:Static fonts:LucideIconFont.Search}" />
    </ui:TextBox.Icon>
</ui:TextBox>
