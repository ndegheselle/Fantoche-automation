<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:controls="clr-namespace:Automation.App.Components.Inputs"
                    xmlns:converters="clr-namespace:Automation.App.Converters"
                    xmlns:fonts="clr-namespace:Automation.App.Assets.Fonts">
    <Style TargetType="{x:Type controls:TagsSelector}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:TagsSelector}">
                    <StackPanel>
                        <Grid Margin="0,0,0,4"
                              Visibility="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType={x:Type controls:TagsSelector}}, Converter={x:Static converters:CommonConverters.InverseBoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="PART_NewTagTextBox"
                                     PlaceholderText="{Binding PlaceholderText, RelativeSource={RelativeSource AncestorType={x:Type controls:TagsSelector}}}"
                                     Text="{Binding NewTag, RelativeSource={RelativeSource AncestorType={x:Type controls:TagsSelector}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button Grid.Column="1"
                                       Margin="4,0,0,0"
                                       Appearance="Secondary"
                                       Padding="6"
                                       BorderBrush="{DynamicResource BorderColor}"
                                       BorderThickness="1"
                                       Command="{Binding AddTagCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:TagsSelector}}}">
                                <TextBlock Style="{DynamicResource LucideIcon}"
                                           Text="{x:Static fonts:LucideIconFont.Plus}" />
                            </ui:Button>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Tags, RelativeSource={RelativeSource AncestorType={x:Type controls:TagsSelector}}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="2"
                                            CornerRadius="10"
                                            Padding="8,2"
                                            BorderBrush="{DynamicResource BorderColor}"
                                            BorderThickness="1"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock VerticalAlignment="Center" Text="{Binding}" />
                                            <Button Margin="2,0,0,0"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Command="{Binding RemoveTagCommand, RelativeSource={RelativeSource AncestorType={x:Type controls:TagsSelector}}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType={x:Type controls:TagsSelector}}, Converter={x:Static converters:CommonConverters.InverseBoolToVisibility}}">
                                                <TextBlock Style="{DynamicResource LucideIcon}"
                                                           FontSize="10"
                                                           Width="10" Height="10"
                                                           Text="{x:Static fonts:LucideIconFont.x}" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
