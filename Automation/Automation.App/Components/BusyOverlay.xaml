<UserControl x:Class="Automation.App.Components.BusyOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:Automation.App.Converters"
             x:Name="Root">
    <Grid Background="#33000000"
          Visibility="{Binding IsBusy, ElementName=Root, Converter={x:Static converters:CommonConverters.BoolToVisibility}}">
        <ui:ProgressRing IsIndeterminate="True"
                         Width="36" Height="36"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</UserControl>
