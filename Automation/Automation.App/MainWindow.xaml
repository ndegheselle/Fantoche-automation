<ui:FluentWindow
    x:Class="Automation.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="clr-namespace:Automation.App.Components"
    xmlns:converters="clr-namespace:Automation.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fonts="clr-namespace:Automation.App.Assets.Fonts"
    xmlns:history="clr-namespace:Automation.App.Features.History"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:packageComponents="clr-namespace:Automation.App.Features.Packages.Components"
    xmlns:packages="clr-namespace:Automation.App.Features.Packages"
    xmlns:root="clr-namespace:Automation.App"
    xmlns:scoped="clr-namespace:Automation.App.Features.Scoped"
    xmlns:scopedComponents="clr-namespace:Automation.App.Features.Scoped.Components"
    xmlns:uiServices="clr-namespace:Automation.App.Services.UI"
    Title="Automation.App"
    Width="1200"
    Height="760"
    MinWidth="800"
    MinHeight="500"
    d:DataContext="{d:DesignInstance Type=root:MainVm}"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <ui:FluentWindow.Resources>
        <!--  Main content pages  -->
        <DataTemplate DataType="{x:Type packages:PackagesPageVm}">
            <packages:PackagesPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type scoped:WorkflowsPageVm}">
            <scoped:WorkflowsPage />
        </DataTemplate>
        <DataTemplate DataType="{x:Type history:HistoryPageVm}">
            <history:HistoryPage />
        </DataTemplate>

        <!--  Overlays  -->
        <DataTemplate DataType="{x:Type packages:PackageDetailsVm}">
            <packages:PackageDetailsOverlay />
        </DataTemplate>
        <DataTemplate DataType="{x:Type packageComponents:PackageTasksVm}">
            <packageComponents:PackageTasksOverlay />
        </DataTemplate>

        <!--  Dialog content  -->
        <DataTemplate DataType="{x:Type scopedComponents:MetadataEditVm}">
            <scopedComponents:MetadataEditDialog />
        </DataTemplate>
        <DataTemplate DataType="{x:Type scopedComponents:ScopeSelectorVm}">
            <scopedComponents:ScopeSelectorDialog />
        </DataTemplate>
        <DataTemplate DataType="{x:Type packageComponents:TaskTargetPickerVm}">
            <packageComponents:TaskTargetPickerDialog />
        </DataTemplate>

        <!--  Simple confirmation dialog  -->
        <DataTemplate DataType="{x:Type uiServices:MessageDialogVm}">
            <StackPanel MinWidth="320" Margin="4">
                <TextBlock
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="{Binding Title}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,8,0,0"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding Message}"
                    TextWrapping="Wrap" />
                <ItemsControl
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    ItemsSource="{Binding Buttons}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Button
                                MinWidth="80"
                                Margin="8,0,0,0"
                                Command="{Binding Command}"
                                Content="{Binding Text}">
                                <ui:Button.Style>
                                    <Style BasedOn="{StaticResource {x:Type ui:Button}}" TargetType="ui:Button">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Style}" Value="{x:Static uiServices:DialogButtonStyle.Primary}">
                                                <Setter Property="Appearance" Value="Primary" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Style}" Value="{x:Static uiServices:DialogButtonStyle.Destructive}">
                                                <Setter Property="Appearance" Value="Danger" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Automation.App" Grid.Row="0">
            <ui:TitleBar.TrailingContent>
                <ui:Button
                    Margin="0,0,8,0"
                    Padding="8"
                    Appearance="Secondary"
                    Command="{Binding SwitchThemeCommand}"
                    ToolTip="Switch theme">
                    <TextBlock Style="{StaticResource LucideIcon}" Text="{Binding CurrentTheme, Converter={x:Static converters:ThemeModeConverters.ToLucideIcon}}" />
                </ui:Button>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Sidebar  -->
            <Border
                Grid.Column="0"
                Width="220"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
                <StackPanel Margin="8">
                    <TextBlock
                        Margin="8,4"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="WORK" />
                    <ui:Button
                        Margin="0,1"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Appearance="Transparent"
                        BorderThickness="0"
                        Command="{Binding OpenWorkflowsCommand}"
                        Content="Tasks and workflows">
                        <ui:Button.Icon>
                            <components:LucideIcon Glyph="{x:Static fonts:LucideIconFont.Workflow}" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button
                        Margin="0,1"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Appearance="Transparent"
                        Command="{Binding OpenPackagesCommand}"
                        Content="Packages">
                        <ui:Button.Icon>
                            <components:LucideIcon Glyph="{x:Static fonts:LucideIconFont.PackageOpen}" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button
                        Margin="0,1"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Appearance="Transparent"
                        Command="{Binding OpenHistoryCommand}"
                        Content="History">
                        <ui:Button.Icon>
                            <components:LucideIcon Glyph="{x:Static fonts:LucideIconFont.Logs}" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <TextBlock
                        Margin="8,16,8,4"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="EXECUTIONS" />
                    <ui:Button
                        Margin="0,1"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Appearance="Transparent"
                        Content="Workers"
                        IsEnabled="False">
                        <ui:Button.Icon>
                            <components:LucideIcon Glyph="{x:Static fonts:LucideIconFont.Server}" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button
                        Margin="0,1"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Appearance="Transparent"
                        Content="Storage"
                        IsEnabled="False">
                        <ui:Button.Icon>
                            <components:LucideIcon Glyph="{x:Static fonts:LucideIconFont.Database}" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </Border>

            <!--  Content + overlays + dialog + toasts  -->
            <Grid Grid.Column="1">
                <ContentControl Content="{Binding Navigation.CurrentPage}" />

                <ItemsControl
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    ItemsSource="{Binding Navigation.Overlays}"
                    Visibility="{Binding Navigation.HasOverlays, Converter={x:Static converters:CommonConverters.BoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Grid />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!--  Dialog host  -->
                <Grid Background="#99000000" Visibility="{Binding DialogManager.IsOpen, Converter={x:Static converters:CommonConverters.BoolToVisibility}}">
                    <ui:Card
                        MinWidth="320"
                        MaxWidth="{Binding DialogManager.MaxWidth}"
                        Margin="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <ContentControl Content="{Binding DialogManager.CurrentContent}" />
                    </ui:Card>
                </Grid>

                <!--  Toast host  -->
                <ItemsControl
                    Width="340"
                    Margin="16"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    ItemsSource="{Binding ToastManager.Toasts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Margin="0,6,0,0" Padding="12">
                                <StackPanel>
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="{Binding Title}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Content}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
