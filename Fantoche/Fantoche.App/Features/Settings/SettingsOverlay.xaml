<UserControl
    x:Class="Fantoche.App.Features.Settings.SettingsOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:jonverters="clr-namespace:Joufflu.Converters;assembly=Joufflu"
    xmlns:joolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Fantoche.App.Features.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:SettingsViewModel}"
    mc:Ignorable="d">
    <StackPanel
        Width="500"
        Margin="0,4,0,0"
        joolkit:Spacing.Gap="4">
        <GroupBox Header="Appearance">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Opacity="{DynamicResource {x:Static joufflu:Colors.MutedOpacity}}">
                    Theme
                </TextBlock>
                <ComboBox
                    Grid.Column="1"
                    ItemsSource="{Binding Themes}"
                    SelectedItem="{Binding Theme, Mode=TwoWay}" />
            </Grid>
        </GroupBox>
        <GroupBox Header="Execution">
            <StackPanel joolkit:Spacing.Gap="4">
                <Grid joolkit:Spacing.Gap="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <CheckBox Grid.Column="1" IsChecked="{Binding IsStandalone}">Standalone</CheckBox>
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        FontSize="11"
                        Opacity="{DynamicResource {x:Static joufflu:Colors.MutedOpacity}}"
                        TextWrapping="Wrap">
                        Applied when the application starts again.
                    </TextBlock>
                </Grid>

                <Grid joolkit:Spacing.Gap="4" Visibility="{Binding IsStandalone, Converter={x:Static jonverters:VisibilityConverter.Default}, ConverterParameter=False}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center" Opacity="{DynamicResource {x:Static joufflu:Colors.MutedOpacity}}">
                        Supervisor address
                    </TextBlock>
                    <TextBox Grid.Column="1" Text="{Binding SupervisorUrl, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </StackPanel>
        </GroupBox>
        <StackPanel
            HorizontalAlignment="Right"
            joolkit:Spacing.Gap="4"
            Orientation="Horizontal">
            <Button Command="{Binding CancelCommand}">Cancel</Button>
            <Button Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}">Save</Button>
        </StackPanel>
    </StackPanel>
</UserControl>
