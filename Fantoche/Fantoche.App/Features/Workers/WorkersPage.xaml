<UserControl
    x:Class="Fantoche.App.Features.Workers.WorkersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Fantoche.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:jeedback="clr-namespace:Joufflu.Feedback.Controls;assembly=Joufflu.Feedback"
    xmlns:jonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:jonverters="clr-namespace:Joufflu.Converters;assembly=Joufflu"
    xmlns:joolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Fantoche.App.Features.Workers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Padding="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}"
    d:DataContext="{d:DesignInstance Type=local:WorkersViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style
            x:Key="WorkerStateBadge"
            BasedOn="{StaticResource {x:Type jeedback:Badge}}"
            TargetType="{x:Type jeedback:Badge}">
            <Setter Property="Content" Value="{Binding State}" />
            <Setter Property="Variant" Value="Success" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="{x:Static local:EnumWorkerState.Working}">
                    <Setter Property="Variant" Value="Info" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Static local:EnumWorkerState.Full}">
                    <Setter Property="Variant" Value="Warning" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  The executions of a queue, the ones of a worker or the ones waiting for one.  -->
        <Style x:Key="ExecutionsGrid" TargetType="{x:Type DataGrid}" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="joolkit:Sizing.Size" Value="xs" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ItemsSource.Count, RelativeSource={RelativeSource Self}}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="EmptyQueue" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Muted}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource {x:Static joufflu:Dimensions.TitleBarHeightOffset}}" joolkit:Spacing.Gap="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <Button
                DockPanel.Dock="Right"
                joolkit:Sizing.IsSquare="True"
                joolkit:Sizing.Size="sm"
                Command="{Binding RefreshCommand}"
                Style="{StaticResource GhostButton}"
                ToolTip="Refresh">
                <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.RefreshCw}" />
            </Button>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="16"
                FontWeight="SemiBold">
                Workers
            </TextBlock>
        </DockPanel>

        <TextBlock
            Grid.Row="1"
            Foreground="{DynamicResource {x:Static joufflu:Brushes.DangerBrush}}"
            Text="{Binding SupervisorError}"
            TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="{x:Type TextBlock}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SupervisorError, Converter={x:Static converters:HasValueConverter.Default}}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel joolkit:Spacing.Gap="4">
                <ItemsControl ItemsSource="{Binding Workers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel joolkit:Spacing.Gap="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:WorkerItem}">
                            <GroupBox>
                                <GroupBox.Header>
                                    <StackPanel joolkit:Spacing.Gap="8" Orientation="Horizontal">
                                        <jonts:FontIcon VerticalAlignment="Center">
                                            <jonts:FontIcon.Style>
                                                <Style BasedOn="{StaticResource {x:Type jonts:FontIcon}}" TargetType="{x:Type jonts:FontIcon}">
                                                    <Setter Property="Text" Value="{x:Static jonts:LucideFontIcons.Server}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLocal}" Value="True">
                                                            <Setter Property="Text" Value="{x:Static jonts:LucideFontIcons.Monitor}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </jonts:FontIcon.Style>
                                        </jonts:FontIcon>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Text="{Binding Name}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource Muted}"
                                            Text="{Binding Description}" />
                                        <jeedback:Badge VerticalAlignment="Center" Style="{StaticResource WorkerStateBadge}" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource Muted}"
                                            Text="{Binding Load}" />
                                    </StackPanel>
                                </GroupBox.Header>
                                <StackPanel>
                                    <DataGrid ItemsSource="{Binding Queue}" Style="{StaticResource ExecutionsGrid}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn
                                                Width="*"
                                                Binding="{Binding Name}"
                                                Header="Running" />
                                            <DataGridTextColumn Binding="{Binding CreatedAt, StringFormat=\{0:g\}}" Header="Started" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock DataContext="{Binding Queue}" Style="{StaticResource EmptyQueue}">
                                        Nothing running.
                                    </TextBlock>
                                </StackPanel>
                            </GroupBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <GroupBox Header="Waiting for a worker" Visibility="{Binding IsStandalone, Converter={x:Static jonverters:VisibilityConverter.Default}, ConverterParameter=False}">
                    <StackPanel>
                        <DataGrid ItemsSource="{Binding Waiting}" Style="{StaticResource ExecutionsGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding Name}"
                                    Header="Waiting" />
                                <DataGridTextColumn Binding="{Binding CreatedAt, StringFormat=\{0:g\}}" Header="Started" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock DataContext="{Binding Waiting}" Style="{StaticResource EmptyQueue}">
                            Nothing waiting.
                        </TextBlock>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
