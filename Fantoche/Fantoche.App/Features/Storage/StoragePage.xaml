<UserControl
    x:Class="Fantoche.App.Features.Storage.StoragePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:jonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:joolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Fantoche.App.Features.Storage"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:StorageViewModel}"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Margin="{StaticResource {x:Static joufflu:Dimensions.SpacingThickness}}" joolkit:Spacing.Gap="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <Button
                DockPanel.Dock="Right"
                joolkit:Sizing.IsSquare="True"
                joolkit:Sizing.Size="sm"
                Command="{Binding RefreshCommand}"
                Style="{StaticResource SecondaryButton}"
                ToolTip="Refresh">
                <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.RefreshCw}" />
            </Button>
            <StackPanel VerticalAlignment="Center">
                <TextBlock FontWeight="SemiBold">
                    <Run Text="Total" />
                    <Run Text="{Binding Total, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Opacity="0.6" Text="Storage kept by the worker of this application, for the last executions of each task or workflow." />
            </StackPanel>
        </DockPanel>

        <DataGrid
            Grid.Row="1"
            AutoGenerateColumns="False"
            CanUserReorderColumns="False"
            IsReadOnly="True"
            ItemsSource="{Binding Rows}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Name}"
                    Header="Task / workflow" />
                <DataGridTextColumn Binding="{Binding Type}" Header="Type" />
                <DataGridTextColumn Binding="{Binding Executions}" Header="Executions kept" />
                <DataGridTextColumn
                    Binding="{Binding Size}"
                    Header="Size"
                    SortMemberPath="Bytes" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
