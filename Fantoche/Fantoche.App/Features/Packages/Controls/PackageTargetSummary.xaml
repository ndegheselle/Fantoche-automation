<UserControl
    x:Class="Fantoche.App.Features.Packages.Controls.PackageTargetSummary"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:execution="clr-namespace:Fantoche.Shared.Data.Execution;assembly=Fantoche.Shared"
    xmlns:feedback="clr-namespace:Joufflu.Feedback.Controls;assembly=Joufflu.Feedback"
    xmlns:jonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:joolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=execution:PackageClassTarget}"
    mc:Ignorable="d">
    <Border Style="{StaticResource Card}">
        <StackPanel joolkit:Spacing.Gap="4" Orientation="Horizontal">
            <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.FileBox}" />
            <TextBlock
                VerticalAlignment="Center"
                Text="{Binding ClassFullName}"
                TextTrimming="CharacterEllipsis" />
            <feedback:Badge VerticalAlignment="Center" Content="{Binding Package.Version}" />
        </StackPanel>
    </Border>
</UserControl>
