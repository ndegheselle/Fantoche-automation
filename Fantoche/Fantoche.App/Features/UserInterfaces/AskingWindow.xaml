<jontrols:ThemedWindow
    x:Class="Fantoche.App.Features.UserInterfaces.AskingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Fantoche.App.Features.Workflows.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:jontrols="clr-namespace:Joufflu.Controls;assembly=Joufflu"
    xmlns:jonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:jonverters="clr-namespace:Joufflu.Converters;assembly=Joufflu"
    xmlns:joolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Fantoche.App.Features.UserInterfaces"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{Binding Title}"
    Width="900"
    Height="700"
    d:DataContext="{d:DesignInstance Type=local:AskingViewModel}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <!--  A window of its own : the run goes on meanwhile, and the user can follow it beside.  -->
    <Grid Margin="8" joolkit:Spacing.Gap="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Visibility="{Binding LoadError, Converter={x:Static jonverters:VisibilityConverter.Default}}">
            <jonts:FontIcon Foreground="{DynamicResource {x:Static joufflu:Brushes.WarningBrush}}" Text="{x:Static jonts:LucideFontIcons.AlertTriangle}" />
            <TextBlock
                Margin="4,0,0,0"
                Foreground="{DynamicResource {x:Static joufflu:Brushes.WarningBrush}}"
                Text="{Binding LoadError}"
                TextWrapping="Wrap" />
        </StackPanel>

        <!--  The interface of the task, or the form generated from its parameters.  -->
        <ContentControl
            Grid.Row="1"
            Content="{Binding View}"
            Visibility="{Binding View, Converter={x:Static jonverters:VisibilityConverter.Default}}" />
        <controls:ParametersFormView
            Grid.Row="1"
            VerticalAlignment="Top"
            DataContext="{Binding Form}"
            Visibility="{Binding Form, Converter={x:Static jonverters:VisibilityConverter.Default}}" />

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            Visibility="{Binding Error, Converter={x:Static jonverters:VisibilityConverter.Default}}">
            <jonts:FontIcon Foreground="{DynamicResource {x:Static joufflu:Brushes.DangerBrush}}" Text="{x:Static jonts:LucideFontIcons.AlertCircle}" />
            <TextBlock
                Margin="4,0,0,0"
                Foreground="{DynamicResource {x:Static joufflu:Brushes.DangerBrush}}"
                Text="{Binding Error}"
                TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel
            Grid.Row="3"
            HorizontalAlignment="Right"
            joolkit:Spacing.Gap="4"
            Orientation="Horizontal">
            <!--  Closed unanswered, the task asks on : it is opened again from its run.  -->
            <Button Command="{Binding AnswerLaterCommand}">Later</Button>
            <Button Command="{Binding ConfirmCommand}" Style="{StaticResource PrimaryButton}">
                <StackPanel Orientation="Horizontal">
                    <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Check}" />
                    <TextBlock Margin="4,0,0,0">Confirm</TextBlock>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</jontrols:ThemedWindow>
