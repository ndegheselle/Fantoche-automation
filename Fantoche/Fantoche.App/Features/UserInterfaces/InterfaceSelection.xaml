<UserControl
    x:Class="Fantoche.App.Features.UserInterfaces.InterfaceSelection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:jonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:jonverters="clr-namespace:Joufflu.Converters;assembly=Joufflu"
    xmlns:joolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Fantoche.App.Features.UserInterfaces"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:packages="clr-namespace:Fantoche.App.Features.Packages.Controls"
    d:DataContext="{d:DesignInstance Type=local:InterfaceSelectionViewModel}"
    mc:Ignorable="d">
    <StackPanel joolkit:Spacing.Gap="4">
        <TextBlock Opacity="{DynamicResource {x:Static joufflu:Colors.MutedOpacity}}">Interface</TextBlock>

        <!--  Picked from a package of interfaces  -->
        <Grid VerticalAlignment="Top" Visibility="{Binding HasTarget, Converter={x:Static jonverters:VisibilityConverter.Default}}">
            <packages:PackageTargetSummary DataContext="{Binding Target}" />
            <Button
                Margin="{StaticResource {x:Static joufflu:Dimensions.Spacing}}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                joolkit:Sizing.IsSquare="True"
                joolkit:Sizing.Size="sm"
                Command="{Binding RemoveCommand}"
                Style="{StaticResource SoftDangerButton}"
                ToolTip="Use the generated form">
                <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Trash}" />
            </Button>
        </Grid>

        <!--  The form generated from the parameters  -->
        <Grid Visibility="{Binding HasTarget, Converter={x:Static jonverters:VisibilityConverter.Default}, ConverterParameter=False}">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.FileText}" />
                <TextBlock Margin="8,0,0,0">The form generated from its parameters.</TextBlock>
            </StackPanel>
            <Button HorizontalAlignment="Right" Command="{Binding SelectCommand}">
                <StackPanel Orientation="Horizontal">
                    <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Package}" />
                    <TextBlock Margin="4,0,0,0">Select interface</TextBlock>
                </StackPanel>
            </Button>
        </Grid>
    </StackPanel>
</UserControl>
