<UserControl
    x:Class="Fantoche.App.Features.Workflows.Controls.ParametersFormView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:data="clr-namespace:Joufflu.Data.Controls;assembly=Joufflu.Data"
    xmlns:jonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:jonverters="clr-namespace:Joufflu.Converters;assembly=Joufflu"
    xmlns:joolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Fantoche.App.Features.Workflows.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:ParametersForm}"
    mc:Ignorable="d">
    <Grid joolkit:Spacing.Gap="4">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <data:DataFill
            Height="240"
            ManualValues="{Binding References}"
            Node="{Binding Values, Mode=OneWay}" />

        <!--  Errors, the parameters being refused while there is any  -->
        <ItemsControl
            Grid.Row="1"
            ItemsSource="{Binding Errors}"
            Visibility="{Binding HasErrors, Converter={x:Static jonverters:VisibilityConverter.Default}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <jonts:FontIcon Foreground="{DynamicResource {x:Static joufflu:Brushes.DangerBrush}}" Text="{x:Static jonts:LucideFontIcons.AlertCircle}" />
                        <TextBlock
                            Margin="4,0,0,0"
                            Foreground="{DynamicResource {x:Static joufflu:Brushes.DangerBrush}}"
                            Text="{Binding}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
