<UserControl
    x:Class="Fantoche.App.Features.Workflows.Controls.ParametersInputView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:jonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:jonverters="clr-namespace:Joufflu.Converters;assembly=Joufflu"
    xmlns:joolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Fantoche.App.Features.Workflows.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:ParametersInput}"
    mc:Ignorable="d">
    <Grid joolkit:Spacing.Gap="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Foreground="{DynamicResource {x:Static joufflu:Brushes.WarningBrush}}"
            Text="{Binding LoadError}"
            TextWrapping="Wrap"
            Visibility="{Binding LoadError, Converter={x:Static jonverters:VisibilityConverter.Default}}" />

        <!--  Either the generated form or the interface of the element  -->
        <local:ParametersFormView
            Grid.Row="1"
            DataContext="{Binding Form}"
            Visibility="{Binding Form, Converter={x:Static jonverters:VisibilityConverter.Default}}" />
        <ContentControl
            Grid.Row="1"
            MinHeight="300"
            Content="{Binding View}"
            Visibility="{Binding View, Converter={x:Static jonverters:VisibilityConverter.Default}}" />

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            Visibility="{Binding Refusal, Converter={x:Static jonverters:VisibilityConverter.Default}}">
            <jonts:FontIcon Foreground="{DynamicResource {x:Static joufflu:Brushes.DangerBrush}}" Text="{x:Static jonts:LucideFontIcons.AlertCircle}" />
            <TextBlock
                Margin="4,0,0,0"
                Foreground="{DynamicResource {x:Static joufflu:Brushes.DangerBrush}}"
                Text="{Binding Refusal}"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
