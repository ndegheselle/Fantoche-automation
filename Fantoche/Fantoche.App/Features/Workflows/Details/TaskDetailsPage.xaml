<UserControl
    x:Class="Fantoche.App.Features.Workflows.Details.TaskDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Fantoche.App.Features.Packages.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:details="clr-namespace:Fantoche.App.Features.Workflows.Details.Controls"
    xmlns:jonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:jonverters="clr-namespace:Joufflu.Converters;assembly=Joufflu"
    xmlns:joolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Fantoche.App.Features.Workflows.Details"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:TaskDetailsViewModel}"
    mc:Ignorable="d">
    <TabControl SelectedValue="{Binding CurrentTab, Mode=TwoWay}" SelectedValuePath="Tag">
        <TabItem Header="Settings" Tag="{x:Static local:EnumDetailTab.Settings}">
            <Grid joolkit:Spacing.Gap="4">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <StackPanel joolkit:Spacing.Gap="4">

                    <details:MetadataEditor DataContext="{Binding Metadata}" />

                    <TextBlock Opacity="{DynamicResource {x:Static joufflu:Colors.MutedOpacity}}">Task</TextBlock>
                    <Grid Visibility="{Binding Metadata.IsReadOnly, Mode=OneTime, Converter={x:Static jonverters:VisibilityConverter.Default}, ConverterParameter=False}">
                        <!--  Current package  -->
                        <Grid VerticalAlignment="Top" Visibility="{Binding HasTarget, Converter={x:Static jonverters:VisibilityConverter.Default}}">
                            <controls:PackageTargetSummary DataContext="{Binding Target}" />
                            <Button
                                Margin="{StaticResource {x:Static joufflu:Dimensions.Spacing}}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                joolkit:Sizing.IsSquare="True"
                                joolkit:Sizing.Size="sm"
                                Command="{Binding RemovePackageCommand}"
                                Style="{StaticResource SoftDangerButton}"
                                ToolTip="Remove the package">
                                <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Trash}" />
                            </Button>
                        </Grid>

                        <!--  No package yet  -->
                        <StackPanel
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            joolkit:Spacing.Gap="4"
                            Visibility="{Binding HasTarget, Converter={x:Static jonverters:VisibilityConverter.Default}, ConverterParameter=False}">
                            <StackPanel Orientation="Horizontal">
                                <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.CircleSlash2}" />
                                <TextBlock Margin="8,0,0,0">No target, select a package to setup the task.</TextBlock>
                            </StackPanel>
                            <Button HorizontalAlignment="Center" Command="{Binding SelectPackageCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Package}" />
                                    <TextBlock Margin="4,0,0,0">Select package</TextBlock>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                    </Grid>

                    <TextBlock Opacity="{DynamicResource {x:Static joufflu:Colors.MutedOpacity}}">Execution settings</TextBlock>
                    <StackPanel
                        joolkit:Spacing.Gap="4"
                        Orientation="Horizontal"
                        ToolTip="How many of its last executions keep the tables and files they wrote, on each worker running it."
                        Visibility="{Binding Metadata.IsReadOnly, Mode=OneTime, Converter={x:Static jonverters:VisibilityConverter.Default}, ConverterParameter=False}">
                        <TextBlock VerticalAlignment="Center">Executions keeping their storage</TextBlock>
                        <TextBox Width="60" Text="{Binding StorageRetention, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </StackPanel>

                <details:ScopedActions Grid.Row="1" />
            </Grid>
        </TabItem>
        <TabItem Header="History" Tag="{x:Static local:EnumDetailTab.History}">
            <details:HistoryTable DataContext="{Binding History}" />
        </TabItem>
        <TabItem
            Header="Schedules"
            Tag="{x:Static local:EnumDetailTab.Schedules}"
            Visibility="{Binding Metadata.IsReadOnly, Mode=OneTime, Converter={x:Static jonverters:VisibilityConverter.Default}, ConverterParameter=False}">
            <details:SchedulesTable DataContext="{Binding Schedules}" />
        </TabItem>
        <TabItem Header="Usages" Tag="{x:Static local:EnumDetailTab.Usages}">
            <details:UsagesTable DataContext="{Binding Usages}" />
        </TabItem>
    </TabControl>
</UserControl>
