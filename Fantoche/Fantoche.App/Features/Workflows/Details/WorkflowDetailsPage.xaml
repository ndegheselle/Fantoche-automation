<UserControl
    x:Class="Fantoche.App.Features.Workflows.Details.WorkflowDetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Fantoche.App.Features.Workflows.Details.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:editor="clr-namespace:Fantoche.App.Features.Workflows.Editor"
    xmlns:joolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Fantoche.App.Features.Workflows.Details"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:WorkflowDetailsViewModel}"
    mc:Ignorable="d">
    <TabControl SelectedValue="{Binding CurrentTab, Mode=TwoWay}" SelectedValuePath="Tag">
        <TabItem Header="Settings" Tag="{x:Static local:EnumDetailTab.Settings}">
            <Grid joolkit:Spacing.Gap="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <controls:MetadataEditor DataContext="{Binding Metadata}" />

                <StackPanel
                    Grid.Row="1"
                    VerticalAlignment="Top"
                    joolkit:Spacing.Gap="4">

                    <TextBlock Opacity="{DynamicResource {x:Static joufflu:Colors.MutedOpacity}}">Execution settings</TextBlock>
                    <CheckBox IsChecked="{Binding StopIfAnyTaskFail}">Stop if any task fail</CheckBox>
                </StackPanel>

                <controls:ScopedActions Grid.Row="2" />
            </Grid>
        </TabItem>
        <TabItem Header="History" Tag="{x:Static local:EnumDetailTab.History}">
            <controls:HistoryTable DataContext="{Binding History}" />
        </TabItem>
        <TabItem Header="Schedules" Tag="{x:Static local:EnumDetailTab.Schedules}">
            <controls:SchedulesTable DataContext="{Binding Schedules}" />
        </TabItem>
        <TabItem Header="Usages" Tag="{x:Static local:EnumDetailTab.Usages}">
            <controls:UsagesTable DataContext="{Binding Usages}" />
        </TabItem>
        <TabItem Header="Editor" Tag="{x:Static local:EnumDetailTab.Editor}">
            <editor:WorkflowEditor DataContext="{Binding Editor}" />
        </TabItem>
    </TabControl>
</UserControl>
