<UserControl
    x:Class="Fantoche.App.Features.Workflows.Details.Controls.HistoryTable"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="clr-namespace:Fantoche.App.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:javigation="clr-namespace:Joufflu.Navigation.Controls;assembly=Joufflu.Navigation"
    xmlns:jeedback="clr-namespace:Joufflu.Feedback.Controls;assembly=Joufflu.Feedback"
    xmlns:jonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:jonverters="clr-namespace:Joufflu.Converters;assembly=Joufflu"
    xmlns:joolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Fantoche.App.Features.Workflows.Details.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:HistoryViewModel}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Fantoche.App;component/Features/Workflows/Details/Controls/InstanceState.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <common:BindingProxy x:Key="ViewModel" Data="{Binding}" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid joolkit:Spacing.Gap="4">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <DataGrid
            Grid.Row="0"
            AutoGenerateColumns="False"
            CanUserReorderColumns="False"
            IsReadOnly="True"
            ItemsSource="{Binding Instances}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding NodeName}"
                    Header="Name" />
                <DataGridTemplateColumn Width="100" Header="State">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <jeedback:Badge Style="{StaticResource InstanceStateBadge}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn
                    Width="100"
                    Binding="{Binding CreatedAt, StringFormat=\{0:g\}}"
                    Header="Started" />
                <DataGridTextColumn
                    Width="100"
                    Binding="{Binding FinishedAt, StringFormat=\{0:g\}}"
                    Header="Finished" />
                <DataGridTemplateColumn Width="64">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!--  Only in the history of a workflow, whose page holds the editor  -->
                            <Button
                                HorizontalAlignment="Right"
                                joolkit:Sizing.IsSquare="True"
                                Command="{Binding Data.OpenRunInEditorCommand, Source={StaticResource ViewModel}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource GhostButton}"
                                ToolTip="See the run in the editor"
                                Visibility="{Binding Data.CanOpenInEditor, Source={StaticResource ViewModel}, Converter={x:Static jonverters:VisibilityConverter.Default}}">
                                <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Workflow}" />
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="64">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!--  The row only knows its own instance, the command lives on the history  -->
                            <Button
                                HorizontalAlignment="Right"
                                joolkit:Sizing.IsSquare="True"
                                Command="{Binding Data.OpenDetailCommand, Source={StaticResource ViewModel}}"
                                CommandParameter="{Binding}"
                                ToolTip="Detail of the execution">
                                <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.ChevronRight}" />
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="1">
            <TextBlock
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Opacity="0.5"
                Text="{Binding Total, StringFormat={}{0} executions}" />
            <javigation:Paging
                HorizontalAlignment="Right"
                Capacity="{Binding Paging.Capacity, Mode=TwoWay}"
                PageNumber="{Binding Paging.PageNumber, Mode=TwoWay}" />
        </Grid>
    </Grid>
</UserControl>
