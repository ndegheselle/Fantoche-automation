<UserControl
    x:Class="Fantoche.App.Features.Workflows.Details.Controls.SchedulesTable"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:jonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:joolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:local="clr-namespace:Fantoche.App.Features.Workflows.Details.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:SchedulesViewModel}"
    mc:Ignorable="d">
    <Grid joolkit:Spacing.Gap="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Button
            HorizontalAlignment="Left"
            Command="{Binding AddCommand}"
            Style="{StaticResource SecondaryButton}">
            <StackPanel Orientation="Horizontal">
                <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.CalendarClock}" />
                <TextBlock Margin="4,0,0,0">Add a schedule</TextBlock>
            </StackPanel>
        </Button>

        <DataGrid
            Grid.Row="1"
            joolkit:Sizing.Size="xs"
            AutoGenerateColumns="False"
            CanUserReorderColumns="False"
            IsReadOnly="True"
            ItemsSource="{Binding Rows}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Binding="{Binding Schedule.Cron}"
                    FontFamily="Consolas"
                    Header="Cron" />
                <DataGridTextColumn Binding="{Binding NextRun, StringFormat=\{0:ddd dd MMM yyyy HH:mm\}}" Header="Next run" />
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Parameters}"
                    Header="Parameters" />
                <DataGridTemplateColumn>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!--  The row only knows its own schedule, the commands live on the list  -->
                            <StackPanel joolkit:Spacing.Gap="2" Orientation="Horizontal">
                                <Button
                                    joolkit:Sizing.IsSquare="True"
                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource GhostButton}"
                                    ToolTip="Edit the schedule">
                                    <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Pencil}" />
                                </Button>
                                <Button
                                    joolkit:Sizing.IsSquare="True"
                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource GhostButton}"
                                    ToolTip="Remove the schedule">
                                    <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Trash}" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
