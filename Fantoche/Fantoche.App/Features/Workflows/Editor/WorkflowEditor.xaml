<UserControl
    x:Class="Fantoche.App.Features.Workflows.Editor.WorkflowEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:jonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:jonverters="clr-namespace:Joufflu.Converters;assembly=Joufflu"
    xmlns:joolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Fantoche.App.Features.Workflows.Editor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:nodify="clr-namespace:Nodify;assembly=Nodify"
    xmlns:viewModels="clr-namespace:Fantoche.App.Features.Workflows.Editor.ViewModels"
    d:DataContext="{d:DesignInstance Type=local:WorkflowEditorViewModel}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Fantoche.App;component/Features/Workflows/Controls/ScopedIcon.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Editor grid, drawn as two levels of lines following the viewport, as strong as a Joufflu border  -->
            <SolidColorBrush
                x:Key="EditorGridBrush"
                Opacity="0.1"
                Color="{DynamicResource {x:Static joufflu:Colors.ForegroundColor}}" />

            <GeometryDrawing
                x:Key="SmallGridGeometry"
                Brush="{StaticResource EditorGridBrush}"
                Geometry="M0,0 L0,1 0.03,1 0.03,0.03 1,0.03 1,0 Z" />

            <GeometryDrawing
                x:Key="LargeGridGeometry"
                Brush="{StaticResource EditorGridBrush}"
                Geometry="M0,0 L0,1 0.015,1 0.015,0.015 1,0.015 1,0 Z" />

            <DrawingBrush
                x:Key="SmallGridLinesDrawingBrush"
                Drawing="{StaticResource SmallGridGeometry}"
                Opacity="0.5"
                TileMode="Tile"
                Transform="{Binding ViewportTransform, ElementName=Editor}"
                Viewport="0 0 20 20"
                ViewportUnits="Absolute" />

            <DrawingBrush
                x:Key="LargeGridLinesDrawingBrush"
                Drawing="{StaticResource LargeGridGeometry}"
                TileMode="Tile"
                Transform="{Binding ViewportTransform, ElementName=Editor}"
                Viewport="0 0 100 100"
                ViewportUnits="Absolute" />

            <!--
                Body of a node, outlined with the state of its last instance in the run being
                followed : the progress of the workflow is read on the graph itself. Without a state
                (nothing ran yet) it is outlined with what the preview of the graph holds against it,
                and a plain card when it holds up.
            -->
            <Style
                x:Key="NodeCard"
                BasedOn="{StaticResource Card}"
                TargetType="Border">
                <Setter Property="Width" Value="56" />
                <Setter Property="Height" Value="56" />
                <Style.Triggers>
                    <!--
                        Comes first so that a state wins over it : an error belongs to the graph and
                        stands whether or not it ran, but what a run is doing right now is what the
                        reader is following.
                    -->
                    <DataTrigger Binding="{Binding HasErrors}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static joufflu:Brushes.DangerBrush}}" />
                        <Setter Property="BorderThickness" Value="2" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HasState}" Value="True">
                        <Setter Property="BorderThickness" Value="2" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Pending">
                        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static joufflu:Brushes.InfoBrush}}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Waiting">
                        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static joufflu:Brushes.WarningBrush}}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Progressing">
                        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static joufflu:Brushes.InfoBrush}}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Completed">
                        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static joufflu:Brushes.SuccessBrush}}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Failed">
                        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static joufflu:Brushes.DangerBrush}}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Canceled">
                        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static joufflu:Brushes.WarningBrush}}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Suspended">
                        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static joufflu:Brushes.WarningBrush}}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="AwaitingUser">
                        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static joufflu:Brushes.WarningBrush}}" />
                    </DataTrigger>
                    <!--  A page is round : it stands apart from the branches, plugged above its task  -->
                    <DataTrigger Binding="{Binding IsUserInterface}" Value="True">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="CornerRadius" Value="28" />
                    </DataTrigger>
                    <!--
                        Selection outlines the card rather than the whole container, so the name
                        under it can be wider than the card. Comes last : what the reader just picked
                        wins over the state, which the icon still tells.
                    -->
                    <DataTrigger Binding="{Binding IsPreviewingSelection, RelativeSource={RelativeSource AncestorType={x:Type nodify:ItemContainer}}}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static joufflu:Brushes.PrimaryBrush}}" />
                        <Setter Property="BorderThickness" Value="2" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static joufflu:Brushes.PrimaryBrush}}" />
                        <Setter Property="BorderThickness" Value="2" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!--
                Where a page plugs into its task : a diamond on top of the task, under the page.
                It only connects to another one of its kind, the graph refusing anything else.
            -->
            <Style x:Key="UserInterfaceConnector" TargetType="{x:Type nodify:Connector}">
                <Setter Property="Anchor" Value="{Binding Anchor, Mode=OneWayToSource}" />
                <Setter Property="IsConnected" Value="{Binding IsConnected}" />
                <Setter Property="IsEnabled" Value="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="16" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="ToolTip" Value="Page : asks the user for the parameters of the task" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type nodify:Connector}">
                            <Grid Background="{TemplateBinding Background}">
                                <!--
                                    Drawn as a diamond rather than a rotated square : Nodify reads the drag
                                    of a pending connection relative to this element, a rotation would turn
                                    the preview away from the mouse.
                                -->
                                <Path
                                    x:Name="PART_Connector"
                                    Width="16"
                                    Height="16"
                                    Data="M8,0 L16,8 8,16 0,8 Z"
                                    Fill="{DynamicResource {x:Static joufflu:Brushes.Base0Brush}}"
                                    Stroke="{DynamicResource {x:Static joufflu:Brushes.DisplayBorderBrush}}"
                                    StrokeThickness="1.5" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsConnected" Value="True">
                                    <Setter TargetName="PART_Connector" Property="Fill" Value="{DynamicResource {x:Static joufflu:Brushes.DisplayBorderBrush}}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                State of a node in the run being followed, displayed over it. The outline of the node
                already carries the state as a color, but a color stands for two of them (pending and
                progressing are both awaited, waiting and canceled both interrupted) : the icon is
                what tells them apart, and its tooltip how long the node took and what it ended on.
            -->
            <Style
                x:Key="NodeStateIcon"
                BasedOn="{StaticResource {x:Type jonts:FontIcon}}"
                TargetType="{x:Type jonts:FontIcon}">
                <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                <Setter Property="ToolTip" Value="{Binding StateText}" />
                <Setter Property="ToolTipService.InitialShowDelay" Value="0" />
                <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
                <Setter Property="Visibility" Value="{Binding HasState, Converter={x:Static jonverters:VisibilityConverter.Default}}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding State}" Value="Pending">
                        <Setter Property="Text" Value="{x:Static jonts:LucideFontIcons.Hourglass}" />
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static joufflu:Brushes.InfoBrush}}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Waiting">
                        <Setter Property="Text" Value="{x:Static jonts:LucideFontIcons.Timer}" />
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static joufflu:Brushes.WarningBrush}}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Progressing">
                        <Setter Property="Text" Value="{x:Static jonts:LucideFontIcons.Loader}" />
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static joufflu:Brushes.InfoBrush}}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Completed">
                        <Setter Property="Text" Value="{x:Static jonts:LucideFontIcons.Check}" />
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static joufflu:Brushes.SuccessBrush}}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Failed">
                        <Setter Property="Text" Value="{x:Static jonts:LucideFontIcons.AlertCircle}" />
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static joufflu:Brushes.DangerBrush}}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Canceled">
                        <Setter Property="Text" Value="{x:Static jonts:LucideFontIcons.CircleSlash2}" />
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static joufflu:Brushes.WarningBrush}}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Suspended">
                        <Setter Property="Text" Value="{x:Static jonts:LucideFontIcons.CirclePause}" />
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static joufflu:Brushes.WarningBrush}}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="AwaitingUser">
                        <Setter Property="FontSize" Value="{DynamicResource {x:Static joufflu:Dimensions.FontSizeXl}}" />
                        <Setter Property="Text" Value="{x:Static jonts:LucideFontIcons.UserPen}" />
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static joufflu:Brushes.WarningBrush}}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="{x:Type nodify:Node}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static joufflu:Brushes.ForegroundBrush}}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type nodify:Node}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>

                                <!--  Header  -->
                                <Border
                                    Grid.Row="0"
                                    Background="Transparent"
                                    Style="{TemplateBinding HeaderContainerStyle}">
                                    <ContentPresenter ContentSource="Header" />
                                </Border>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="22" />
                                    </Grid.ColumnDefinitions>
                                    <!--  Data IN  -->
                                    <ItemsControl
                                        VerticalAlignment="Center"
                                        Focusable="False"
                                        ItemTemplate="{TemplateBinding InputConnectorTemplate}"
                                        ItemsSource="{TemplateBinding Input}" />

                                    <!--  Body  -->
                                    <Border Grid.Column="1" Style="{StaticResource NodeCard}">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                    </Border>

                                    <!--  Data OUT  -->
                                    <ItemsControl
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Focusable="False"
                                        ItemTemplate="{TemplateBinding OutputConnectorTemplate}"
                                        ItemsSource="{TemplateBinding Output}" />
                                </Grid>

                                <!--  Footer  -->
                                <Border
                                    x:Name="Footer"
                                    Grid.Row="2"
                                    HorizontalAlignment="Center"
                                    Background="Transparent"
                                    IsHitTestVisible="False"
                                    Visibility="{TemplateBinding HasFooter,
                                                                 Converter={x:Static jonverters:VisibilityConverter.Default}}">
                                    <ContentPresenter ContentSource="Footer" />
                                </Border>
                                <!--
                                    Slot of a task, on top of it : where its page plugs, like n8n does for
                                    the tools of an agent. Above so the attachment stays clear of its name.
                                -->
                                <nodify:Connector
                                    Margin="0,0,0,-8"
                                    VerticalAlignment="Bottom"
                                    DataContext="{Binding UserInterfaceSlot}"
                                    Style="{StaticResource UserInterfaceConnector}"
                                    Visibility="{Binding Converter={x:Static jonverters:VisibilityConverter.Default}}" />


                                <!--  Plug of a page, under its name : the attachment comes up from its task  -->
                                <nodify:Connector
                                    Grid.Row="2"
                                    Margin="0,-8,0,0"
                                    VerticalAlignment="Top"
                                    DataContext="{Binding UserInterfacePlug}"
                                    Style="{StaticResource UserInterfaceConnector}"
                                    Visibility="{Binding Converter={x:Static jonverters:VisibilityConverter.Default}}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!--  The plug of a page being under it, its name goes on top to stay clear of the attachment  -->
                                <DataTrigger Binding="{Binding IsUserInterface}" Value="True">
                                    <Setter TargetName="Footer" Property="Grid.Row" Value="0" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>
    <!--  Drop target of the whole editor, the toolbars over it included, so a node can be dropped anywhere in it  -->
    <Border
        joolkit:DropTarget.Command="{Binding DropCommand, RelativeSource={RelativeSource AncestorType={x:Type local:WorkflowEditor}}}"
        Background="{DynamicResource {x:Static joufflu:Brushes.Base0Brush}}"
        BorderThickness="{DynamicResource {x:Static joufflu:Dimensions.Thickness}}"
        ClipToBounds="True"
        CornerRadius="{DynamicResource {x:Static joufflu:Dimensions.Radius}}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static joufflu:Brushes.DisplayBorderBrush}}" />
                <Style.Triggers>
                    <!--  True only for a task or a workflow, what the editor refuses never lights the border up  -->
                    <Trigger Property="joolkit:DropTarget.IsDragOver" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static joufflu:Brushes.PrimaryBrush}}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <!--  The editor background being the grid lines, the solid color comes from the container  -->
        <Grid>
            <nodify:NodifyEditor
                x:Name="Editor"
                Background="{StaticResource SmallGridLinesDrawingBrush}"
                ConnectionCompletedCommand="{Binding ConnectionCompletedCommand}"
                Connections="{Binding Connections}"
                ItemsDragCompletedCommand="{Binding ItemsDragCompletedCommand}"
                ItemsDragStartedCommand="{Binding ItemsDragStartedCommand}"
                ItemsSource="{Binding Nodes}"
                SelectedItems="{Binding SelectedNodes}"
                ViewportLocation="{Binding ViewportLocation, Mode=TwoWay}"
                ViewportSize="{Binding ViewportSize, Mode=OneWayToSource}">
                <!--  Snapping to the small cells of the grid drawn behind the nodes, see SmallGridLinesDrawingBrush  -->
                <nodify:NodifyEditor.Style>
                    <Style BasedOn="{StaticResource {x:Type nodify:NodifyEditor}}" TargetType="{x:Type nodify:NodifyEditor}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSnappingToGrid}" Value="True">
                                <Setter Property="GridCellSize" Value="20" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </nodify:NodifyEditor.Style>
                <nodify:NodifyEditor.InputBindings>
                    <KeyBinding Key="Delete" Command="{Binding RemoveCommand}" />
                    <KeyBinding Command="{Binding History.UndoCommand}" Gesture="Ctrl+Z" />
                    <KeyBinding Command="{Binding History.RedoCommand}" Gesture="Ctrl+Y" />
                </nodify:NodifyEditor.InputBindings>

                <nodify:NodifyEditor.Resources>
                    <DataTemplate DataType="{x:Type viewModels:NodeViewModel}">
                        <nodify:Node
                            Footer="{Binding}"
                            Input="{Binding Inputs}"
                            Output="{Binding Outputs}">
                            <!--
                                The name of a node, edited in place : it is not only a label, a node
                                several branches lead into being read by name.
                            -->
                            <nodify:Node.FooterTemplate>
                                <DataTemplate DataType="{x:Type viewModels:NodeViewModel}">
                                    <Grid>
                                        <TextBlock
                                            MaxWidth="120"
                                            Text="{Binding Name}"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap"
                                            Visibility="{Binding IsRenaming, Converter={x:Static jonverters:VisibilityConverter.Default}, ConverterParameter=False}">
                                            <TextBlock.InputBindings>
                                                <MouseBinding
                                                    Command="{Binding DataContext.RenameCommand, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}"
                                                    CommandParameter="{Binding}"
                                                    Gesture="LeftDoubleClick" />
                                            </TextBlock.InputBindings>
                                        </TextBlock>

                                        <TextBox
                                            Width="120"
                                            joolkit:Sizing.Size="xs"
                                            IsVisibleChanged="OnRenameBoxVisibleChanged"
                                            LostKeyboardFocus="OnRenameBoxLostFocus"
                                            Text="{Binding NameDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Visibility="{Binding IsRenaming, Converter={x:Static jonverters:VisibilityConverter.Default}}">
                                            <TextBox.InputBindings>
                                                <KeyBinding
                                                    Key="Return"
                                                    Command="{Binding DataContext.CommitRenameCommand, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}"
                                                    CommandParameter="{Binding}" />
                                                <KeyBinding
                                                    Key="Escape"
                                                    Command="{Binding DataContext.CancelRenameCommand, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}"
                                                    CommandParameter="{Binding}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                    </Grid>
                                </DataTemplate>
                            </nodify:Node.FooterTemplate>

                            <nodify:Node.InputBindings>
                                <!--  The editor holds the command, the node only knowing its own view model  -->
                                <MouseBinding
                                    Command="{Binding DataContext.OpenNodeCommand, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}"
                                    CommandParameter="{Binding}"
                                    Gesture="LeftDoubleClick" />
                            </nodify:Node.InputBindings>
                            <nodify:Node.InputConnectorTemplate>
                                <DataTemplate DataType="{x:Type viewModels:ConnectorViewModel}">
                                    <nodify:NodeInput
                                        Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                        Background="Transparent"
                                        Header="{Binding Name}"
                                        IsConnected="{Binding IsConnected}"
                                        IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}" />
                                </DataTemplate>
                            </nodify:Node.InputConnectorTemplate>
                            <nodify:Node.OutputConnectorTemplate>
                                <DataTemplate DataType="{x:Type viewModels:ConnectorViewModel}">
                                    <nodify:NodeOutput
                                        Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                        Background="Transparent"
                                        Header="{Binding Name}"
                                        IsConnected="{Binding IsConnected}"
                                        IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}" />
                                </DataTemplate>
                            </nodify:Node.OutputConnectorTemplate>

                            <Grid>
                                <jonts:FontIcon
                                    DataContext="{Binding Metadata}"
                                    FontSize="{DynamicResource {x:Static joufflu:Dimensions.FontSizeXl}}"
                                    Style="{StaticResource ScopedMetadataIcon}" />
                                <!--  Where the node stands in the run being followed, nothing while none is  -->
                                <jonts:FontIcon
                                    x:Name="StateIcon"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource NodeStateIcon}">
                                    <jonts:FontIcon.RenderTransform>
                                        <!--  Turned while the node is progressing. Named so the animation reaches it, and declared here rather than by the style so each node turns on its own  -->
                                        <RotateTransform x:Name="StateIconRotation" />
                                    </jonts:FontIcon.RenderTransform>
                                </jonts:FontIcon>
                            </Grid>
                        </nodify:Node>
                        <DataTemplate.Triggers>
                            <!--
                                A node that is running is the one the reader is waiting on : its icon
                                turns for as long as it does, so the graph tells where the run is at
                                a glance rather than by reading every outline.
                            -->
                            <DataTrigger Binding="{Binding State}" Value="Progressing">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="SpinStateIcon">
                                        <Storyboard>
                                            <DoubleAnimation
                                                RepeatBehavior="Forever"
                                                Storyboard.TargetName="StateIconRotation"
                                                Storyboard.TargetProperty="Angle"
                                                From="0"
                                                To="360"
                                                Duration="0:0:1.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="SpinStateIcon" />
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                            <!--
                                A node waiting for the user is the one holding the run up : its icon
                                pulses so it is seen from afar, whatever the outline color it shares.
                            -->
                            <DataTrigger Binding="{Binding State}" Value="AwaitingUser">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="PulseStateIcon">
                                        <Storyboard>
                                            <DoubleAnimation
                                                AutoReverse="True"
                                                RepeatBehavior="Forever"
                                                Storyboard.TargetName="StateIcon"
                                                Storyboard.TargetProperty="Opacity"
                                                From="1"
                                                To="0.3"
                                                Duration="0:0:0.7" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="PulseStateIcon" />
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </nodify:NodifyEditor.Resources>

                <nodify:NodifyEditor.ItemContainerStyle>
                    <Style BasedOn="{StaticResource {x:Type nodify:ItemContainer}}" TargetType="{x:Type nodify:ItemContainer}">
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        <Setter Property="Location" Value="{Binding Location, Mode=TwoWay}" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <!--  Selection is drawn by the card of the node, see NodeCard  -->
                        <Setter Property="SelectedBrush" Value="Transparent" />
                        <Setter Property="HighlightBrush" Value="Transparent" />
                        <!--  A running workflow can't be edited : the nodes stay where they are  -->
                        <Setter Property="IsDraggable" Value="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}" />

                        <!--
                            Held by the container rather than by the node it holds : Nodify reads
                            ItemContainer.HasContextMenu to know it must leave the right click alone
                            rather than take it for one of its own drag interactions. A menu set any
                            deeper only opens on the second click.
                            The menu itself lives outside the visual tree, so the commands of the
                            editor are reached through the container the menu was opened on : its Tag
                            holds the editor, its DataContext the node.
                        -->
                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}" />
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
                                    <MenuItem
                                        Command="{Binding Tag.ShowErrorCommand}"
                                        CommandParameter="{Binding DataContext}"
                                        Header="Show error"
                                        Visibility="{Binding DataContext.HasFailure, Converter={x:Static jonverters:VisibilityConverter.Default}}">
                                        <MenuItem.Icon>
                                            <jonts:FontIcon Foreground="{DynamicResource {x:Static joufflu:Brushes.DangerBrush}}" Text="{x:Static jonts:LucideFontIcons.AlertCircle}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem
                                        Command="{Binding Tag.Run.AnswerNodeCommand}"
                                        CommandParameter="{Binding DataContext}"
                                        Header="Answer"
                                        Visibility="{Binding DataContext.IsAwaitingUser, Converter={x:Static jonverters:VisibilityConverter.Default}}">
                                        <MenuItem.Icon>
                                            <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.UserPen}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem
                                        Command="{Binding Tag.OpenSettingsCommand}"
                                        CommandParameter="{Binding DataContext}"
                                        Header="Open settings">
                                        <MenuItem.Icon>
                                            <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.SlidersHorizontal}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem
                                        Command="{Binding Tag.RenameCommand}"
                                        CommandParameter="{Binding DataContext}"
                                        Header="Rename">
                                        <MenuItem.Icon>
                                            <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Pencil}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem
                                        Style="{StaticResource DangerMenuItem}"
                                        Command="{Binding Tag.RemoveCommand}"
                                        CommandParameter="{Binding DataContext}"
                                        Header="Remove">
                                        <MenuItem.Icon>
                                            <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Trash}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <!--
                                A node of a selection of several opens the menu acting on all of them.
                                Its commands are left without parameter, which makes them act on the
                                selection. The alignment is the Nodify one, routed from the container
                                to the editor, which records it in the history (see WorkflowEditor).
                            -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                    <Condition Binding="{Binding DataContext.HasMultipleSelection, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="ContextMenu">
                                    <Setter.Value>
                                        <ContextMenu DataContext="{Binding PlacementTarget, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="Align">
                                                <MenuItem.Icon>
                                                    <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.AlignStartVertical}" />
                                                </MenuItem.Icon>
                                                <MenuItem
                                                    Command="{x:Static nodify:EditorCommands.Align}"
                                                    CommandParameter="{x:Static nodify:Alignment.Left}"
                                                    CommandTarget="{Binding}"
                                                    Header="Left">
                                                    <MenuItem.Icon>
                                                        <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.AlignStartVertical}" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem
                                                    Command="{x:Static nodify:EditorCommands.Align}"
                                                    CommandParameter="{x:Static nodify:Alignment.Center}"
                                                    CommandTarget="{Binding}"
                                                    Header="Center vertically">
                                                    <MenuItem.Icon>
                                                        <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.AlignCenterVertical}" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem
                                                    Command="{x:Static nodify:EditorCommands.Align}"
                                                    CommandParameter="{x:Static nodify:Alignment.Right}"
                                                    CommandTarget="{Binding}"
                                                    Header="Right">
                                                    <MenuItem.Icon>
                                                        <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.AlignEndVertical}" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <Separator />
                                                <MenuItem
                                                    Command="{x:Static nodify:EditorCommands.Align}"
                                                    CommandParameter="{x:Static nodify:Alignment.Top}"
                                                    CommandTarget="{Binding}"
                                                    Header="Top">
                                                    <MenuItem.Icon>
                                                        <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.AlignStartHorizontal}" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem
                                                    Command="{x:Static nodify:EditorCommands.Align}"
                                                    CommandParameter="{x:Static nodify:Alignment.Middle}"
                                                    CommandTarget="{Binding}"
                                                    Header="Center horizontally">
                                                    <MenuItem.Icon>
                                                        <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.AlignCenterHorizontal}" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem
                                                    Command="{x:Static nodify:EditorCommands.Align}"
                                                    CommandParameter="{x:Static nodify:Alignment.Bottom}"
                                                    CommandTarget="{Binding}"
                                                    Header="Bottom">
                                                    <MenuItem.Icon>
                                                        <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.AlignEndHorizontal}" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Command="{Binding Tag.RemoveCommand}" Header="Remove the selection" Style="{StaticResource DangerMenuItem}">
                                                <MenuItem.Icon>
                                                    <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Trash}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Setter.Value>
                                </Setter>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </nodify:NodifyEditor.ItemContainerStyle>

                <nodify:NodifyEditor.ConnectionTemplate>
                    <DataTemplate DataType="{x:Type viewModels:ConnectionViewModel}">
                        <!--  The themed style is given explicitly, an implicit style not applying to a derived type  -->
                        <nodify:Connection 
                            x:Name="Line"
                            Source="{Binding Source.Anchor}"
                            Style="{StaticResource {x:Type nodify:Connection}}"
                            Target="{Binding Target.Anchor}"
                            />
                        <DataTemplate.Triggers>
                            <!--
                                A page sits above its task : the attachment goes up, dashed, carrying no
                                branch. Backward because Nodify points a vertical arrowhead by the
                                direction alone, downward otherwise.
                            -->
                            <DataTrigger Binding="{Binding IsUserInterface}" Value="True">
                                <Setter TargetName="Line" Property="SourceOrientation" Value="Vertical" />
                                <Setter TargetName="Line" Property="TargetOrientation" Value="Vertical" />
                                <Setter TargetName="Line" Property="Direction" Value="Backward" />
                                <Setter TargetName="Line" Property="StrokeDashArray" Value="2 2" />
                                <Setter TargetName="Line" Property="Spacing" Value="0" />
                                <Setter TargetName="Line" Property="ArrowSize" Value="0 0" />
                                <Setter TargetName="Line" Property="SourceOffset" Value="0 0" />
                                <Setter TargetName="Line" Property="TargetOffset" Value="0 0" />
                            </DataTrigger>
                            <!--
                                The branch the node it leads to can't handle : the node holds up when
                                another branch reaches it, so what is wrong is coming through here.
                                Set from the template rather than from a style, which would drop the
                                one Nodify gives a connection.
                            -->
                            <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                <Setter TargetName="Line" Property="Stroke" Value="{DynamicResource {x:Static joufflu:Brushes.DangerBrush}}" />
                                <Setter TargetName="Line" Property="StrokeThickness" Value="3" />
                                <Setter TargetName="Line" Property="ToolTip" Value="{Binding ErrorsText}" />
                            </DataTrigger>
                            <!--
                                The path the run took, drawn last so it colors the branch over what
                                the preview holds against it : a branch a run went through resolved,
                                whatever was expected of it. Its tooltip is left alone, it is still
                                the only place the errors are read.
                            -->
                            <DataTrigger Binding="{Binding IsTraversed}" Value="True">
                                <Setter TargetName="Line" Property="Stroke" Value="{DynamicResource {x:Static joufflu:Brushes.PrimaryBrush}}" />
                                <Setter TargetName="Line" Property="StrokeThickness" Value="3" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </nodify:NodifyEditor.ConnectionTemplate>
            </nodify:NodifyEditor>

            <Grid Panel.ZIndex="-2" Background="{StaticResource LargeGridLinesDrawingBrush}" />
            <local:EditorOverlay Editor="{Binding ElementName=Editor}" />
        </Grid>
    </Border>
</UserControl>
