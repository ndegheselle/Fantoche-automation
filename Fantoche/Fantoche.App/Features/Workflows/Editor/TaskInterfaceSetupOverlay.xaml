<UserControl
    x:Class="Fantoche.App.Features.Workflows.Editor.TaskInterfaceSetupOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:jonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:jonverters="clr-namespace:Joufflu.Converters;assembly=Joufflu"
    xmlns:joolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Fantoche.App.Features.Workflows.Editor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    MinWidth="900"
    d:DataContext="{d:DesignInstance Type=local:TaskInterfaceSetupViewModel}"
    mc:Ignorable="d">
    <Grid joolkit:Spacing.Gap="4">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <!--  The interface of the task  -->
        <ContentControl MinHeight="300" Content="{Binding View}" />

        <ItemsControl
            Grid.Row="1"
            ItemsSource="{Binding Errors}"
            Visibility="{Binding HasErrors, Converter={x:Static jonverters:VisibilityConverter.Default}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <jonts:FontIcon Foreground="{DynamicResource {x:Static joufflu:Brushes.DangerBrush}}" Text="{x:Static jonts:LucideFontIcons.AlertCircle}" />
                        <TextBlock
                            Margin="4,0,0,0"
                            Foreground="{DynamicResource {x:Static joufflu:Brushes.DangerBrush}}"
                            Text="{Binding Message}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Right"
            joolkit:Spacing.Gap="4"
            Orientation="Horizontal">
            <Button Command="{Binding CancelCommand}">Cancel</Button>
            <Button Command="{Binding ValidateCommand}" Style="{StaticResource PrimaryButton}">
                <StackPanel Orientation="Horizontal">
                    <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Save}" />
                    <TextBlock Margin="4,0,0,0">Apply</TextBlock>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
