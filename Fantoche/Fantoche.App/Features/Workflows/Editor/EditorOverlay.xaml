<UserControl
    x:Class="Fantoche.App.Features.Workflows.Editor.EditorOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:jonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:jonverters="clr-namespace:Joufflu.Converters;assembly=Joufflu"
    xmlns:joolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Fantoche.App.Features.Workflows.Editor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:nodify="clr-namespace:Nodify;assembly=Nodify"
    d:DataContext="{d:DesignInstance Type=local:WorkflowEditorViewModel}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!--  The editor commands are routed, they need the editor as their target  -->
        <Style
            x:Key="EditorButton"
            BasedOn="{StaticResource GhostButton}"
            TargetType="Button">
            <Setter Property="joolkit:Sizing.IsSquare" Value="True" />
            <Setter Property="CommandTarget" Value="{Binding Editor, RelativeSource={RelativeSource AncestorType={x:Type local:EditorOverlay}}}" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="{DynamicResource {x:Static joufflu:Dimensions.Spacing}}">
        <!--
            Execution : start or resume while nothing runs, pause or stop while a run is followed. A
            paused run can also be stopped, given up on rather than resumed.
        -->
        <Border
            Padding="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Style="{StaticResource Card}">
            <StackPanel joolkit:Spacing.Gap="4" Orientation="Horizontal">
                <Button
                    joolkit:Sizing.IsSquare="True"
                    Command="{Binding Run.StartCommand}"
                    Style="{StaticResource GhostButton}"
                    ToolTip="Start the workflow"
                    Visibility="{Binding Run.IsRunning, Converter={x:Static jonverters:VisibilityConverter.Default}, ConverterParameter=False}">
                    <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.CirclePlay}" />
                </Button>
                <Button
                    joolkit:Sizing.IsSquare="True"
                    Command="{Binding Run.ResumeCommand}"
                    Style="{StaticResource GhostButton}"
                    ToolTip="Resume the run where it stopped"
                    Visibility="{Binding Run.CanResume, Converter={x:Static jonverters:VisibilityConverter.Default}}">
                    <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.StepForward}" />
                </Button>
                <Button
                    joolkit:Sizing.IsSquare="True"
                    Command="{Binding Run.PauseCommand}"
                    Style="{StaticResource GhostButton}"
                    ToolTip="Pause : the running nodes finish, no other starts"
                    Visibility="{Binding Run.IsRunning, Converter={x:Static jonverters:VisibilityConverter.Default}}">
                    <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.CirclePause}" />
                </Button>
                <Button
                    joolkit:Sizing.IsSquare="True"
                    Command="{Binding Run.StopCommand}"
                    Style="{StaticResource GhostButton}"
                    ToolTip="Stop : every running node is canceled"
                    Visibility="{Binding Run.CanStop, Converter={x:Static jonverters:VisibilityConverter.Default}}">
                    <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.CircleStop}" />
                </Button>
            </StackPanel>
        </Border>

        <!--  A past version of the graph, the one a run opened from the history ran on : read only  -->
        <Border
            Padding="8,4"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Style="{StaticResource Card}"
            Visibility="{Binding IsShowingPastVersion, Converter={x:Static jonverters:VisibilityConverter.Default}}">
            <StackPanel joolkit:Spacing.Gap="8" Orientation="Horizontal">
                <jonts:FontIcon VerticalAlignment="Center" Text="{x:Static jonts:LucideFontIcons.History}" />
                <TextBlock VerticalAlignment="Center">
                    <Run Text="Version" />
                    <Run Text="{Binding PastVersion, Mode=OneWay}" />
                    <Run Text="of the graph, read only. The workflow is at version" />
                    <Run Text="{Binding Workflow.Version, Mode=OneWay}" /><Run Text="." />
                </TextBlock>
                <Button Command="{Binding ShowCurrentCommand}" Style="{StaticResource SecondaryButton}">Show current</Button>
            </StackPanel>
        </Border>

        <!--  Editor tools  -->
        <Border
            Padding="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Style="{StaticResource Card}">
            <StackPanel joolkit:Spacing.Gap="4">
                <Button
                    Command="{x:Static nodify:EditorCommands.ZoomIn}"
                    Style="{StaticResource EditorButton}"
                    ToolTip="Zoom in">
                    <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Plus}" />
                </Button>
                <Button
                    Command="{x:Static nodify:EditorCommands.FitToScreen}"
                    Style="{StaticResource EditorButton}"
                    ToolTip="Adjust zoom">
                    <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Fullscreen}" />
                </Button>
                <Button
                    Command="{x:Static nodify:EditorCommands.ZoomOut}"
                    Style="{StaticResource EditorButton}"
                    ToolTip="Zoom out">
                    <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Minus}" />
                </Button>
                <Separator />
                <Button
                    joolkit:Sizing.IsSquare="True"
                    Command="{Binding History.UndoCommand}"
                    Style="{StaticResource GhostButton}"
                    ToolTip="Undo">
                    <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Undo}" />
                </Button>
                <Button
                    joolkit:Sizing.IsSquare="True"
                    Command="{Binding History.RedoCommand}"
                    Style="{StaticResource GhostButton}"
                    ToolTip="Redo">
                    <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Redo}" />
                </Button>
            </StackPanel>
        </Border>

        <!--  Viewport actions  -->
        <Border
            Padding="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Style="{StaticResource Card}">
            <StackPanel joolkit:Spacing.Gap="4" Orientation="Horizontal">
                <Button
                    joolkit:Sizing.IsSquare="True"
                    Command="{Binding AddCommand}"
                    Style="{StaticResource GhostButton}"
                    ToolTip="Add a node">
                    <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Plus}" />
                </Button>
                <Button
                    joolkit:Sizing.IsSquare="True"
                    Command="{Binding OpenSettingsCommand}"
                    Style="{StaticResource GhostButton}"
                    ToolTip="Settings of the selected node">
                    <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Settings}" />
                </Button>
                <Button
                    joolkit:Sizing.IsSquare="True"
                    Command="{Binding RemoveCommand}"
                    Style="{StaticResource GhostButton}"
                    ToolTip="Remove the selected nodes">
                    <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Trash}" />
                </Button>
                <Rectangle
                    Width="1"
                    VerticalAlignment="Stretch"
                    Fill="{DynamicResource {x:Static joufflu:Brushes.DisplayBorderBrush}}" />
                <Button
                    joolkit:Sizing.IsSquare="True"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource GhostButton}"
                    ToolTip="Save the graph">
                    <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Save}" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
