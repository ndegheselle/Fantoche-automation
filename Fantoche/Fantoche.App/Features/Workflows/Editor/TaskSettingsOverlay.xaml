<UserControl
    x:Class="Fantoche.App.Features.Workflows.Editor.TaskSettingsOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:data="clr-namespace:Joufflu.Data.Controls;assembly=Joufflu.Data"
    xmlns:jonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:jonverters="clr-namespace:Joufflu.Converters;assembly=Joufflu"
    xmlns:joolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Fantoche.App.Features.Workflows.Editor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:packages="clr-namespace:Fantoche.App.Features.Packages.Controls"
    x:Name="RootElement"
    MinWidth="900"
    d:DataContext="{d:DesignInstance Type=local:TaskSettingsViewModel}"
    mc:Ignorable="d">

    <Grid Margin="0,4,0,0" joolkit:Spacing.Gap="2">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <packages:PackageTargetSummary DataContext="{Binding Target}" Visibility="{Binding DataContext.HasTarget, ElementName=RootElement, Converter={x:Static jonverters:VisibilityConverter.Default}}" />

        <Grid Grid.Row="1" joolkit:Spacing.Gap="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="300" />
            </Grid.RowDefinitions>

            <TextBlock Style="{StaticResource Muted}" Text="Available (force a field to reference one)" />
            <data:DataDisplay Grid.Row="1" Node="{Binding Context, Mode=OneWay}" />

            <TextBlock
                Grid.Column="1"
                Style="{StaticResource Muted}"
                Text="{Binding Texts.MappingLabel}" />

            <data:DataFill
                Grid.Row="1"
                Grid.Column="1"
                ManualValues="{Binding References}"
                Node="{Binding Mapping, Mode=OneWay}"
                Visibility="{Binding IsFilled, Converter={x:Static jonverters:VisibilityConverter.Default}}" />
            <data:DataEdit
                Grid.Row="1"
                Grid.Column="1"
                ManualValues="{Binding References}"
                Node="{Binding Mapping, Mode=OneWay}"
                Visibility="{Binding IsFilled, Converter={x:Static jonverters:VisibilityConverter.Default}, ConverterParameter=False}" />

            <TextBlock
                Grid.Column="2"
                Style="{StaticResource Muted}"
                Text="{Binding Texts.ExpectedLabel}" />
            <data:DataDisplay
                Grid.Row="1"
                Grid.Column="2"
                Node="{Binding ExpectedNode, Mode=OneWay}" />
            <TextBlock
                Grid.Row="1"
                Grid.Column="2"
                Style="{StaticResource Muted}"
                Text="{Binding Texts.EmptyExpectation}"
                TextWrapping="Wrap"
                Visibility="{Binding ExpectedNode, Converter={x:Static jonverters:VisibilityConverter.Default}, ConverterParameter=False}" />
        </Grid>

        <StackPanel Grid.Row="2" joolkit:Spacing.Gap="4">
            <StackPanel Orientation="Horizontal" Visibility="{Binding IsContextMissing, Converter={x:Static jonverters:VisibilityConverter.Default}}">
                <jonts:FontIcon Foreground="{DynamicResource {x:Static joufflu:Brushes.WarningBrush}}" Text="{x:Static jonts:LucideFontIcons.AlertTriangle}" />
                <TextBlock
                    Margin="4,0,0,0"
                    Foreground="{DynamicResource {x:Static joufflu:Brushes.WarningBrush}}"
                    Text="The graph could not be walked up to this node : the references are neither resolved nor checked."
                    TextWrapping="Wrap" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Errors}" Visibility="{Binding HasErrors, Converter={x:Static jonverters:VisibilityConverter.Default}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <jonts:FontIcon Foreground="{DynamicResource {x:Static joufflu:Brushes.DangerBrush}}" Text="{x:Static jonts:LucideFontIcons.AlertCircle}" />
                            <TextBlock
                                Margin="4,0,0,0"
                                FontFamily="Consolas"
                                Style="{StaticResource Muted}"
                                Text="{Binding Branch, StringFormat='from {0}'}"
                                Visibility="{Binding HasBranch, Converter={x:Static jonverters:VisibilityConverter.Default}}" />
                            <TextBlock
                                Margin="4,0,0,0"
                                Foreground="{DynamicResource {x:Static joufflu:Brushes.DangerBrush}}"
                                Text="{Binding Message}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel
            Grid.Row="3"
            HorizontalAlignment="Right"
            joolkit:Spacing.Gap="4"
            Orientation="Horizontal">
            <Button Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}">Cancel</Button>
            <Button Command="{Binding ValidateCommand}" Style="{StaticResource PrimaryButton}">
                <StackPanel Orientation="Horizontal">
                    <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Save}" />
                    <TextBlock Margin="4,0,0,0">Apply</TextBlock>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
