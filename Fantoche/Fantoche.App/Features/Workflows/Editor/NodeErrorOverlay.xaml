<UserControl
    x:Class="Fantoche.App.Features.Workflows.Editor.NodeErrorOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:joolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:local="clr-namespace:Fantoche.App.Features.Workflows.Editor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=local:NodeErrorViewModel}"
    mc:Ignorable="d">

    <Grid Width="720" joolkit:Spacing.Gap="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MaxHeight="400" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <TextBox
            FontFamily="Consolas"
            IsReadOnly="True"
            Text="{Binding Message, Mode=OneWay}"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto" />

        <Button
            Grid.Row="1"
            HorizontalAlignment="Right"
            Command="{Binding CloseCommand}"
            Style="{StaticResource SecondaryButton}">
            Close
        </Button>
    </Grid>
</UserControl>
