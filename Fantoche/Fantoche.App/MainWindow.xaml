<controls:ThemedWindow
    x:Class="Fantoche.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Joufflu.Controls;assembly=Joufflu"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:javigation="clr-namespace:Joufflu.Navigation.Controls;assembly=Joufflu.Navigation"
    xmlns:jeedback="clr-namespace:Joufflu.Feedback.Controls;assembly=Joufflu.Feedback"
    xmlns:joolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Fantoche.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:nav="clr-namespace:Joufflu.Navigation.Controls;assembly=Joufflu.Navigation"
    xmlns:packages="clr-namespace:Fantoche.App.Features.Packages"
    xmlns:scheduler="clr-namespace:Fantoche.App.Features.Scheduler"
    xmlns:workers="clr-namespace:Fantoche.App.Features.Workers"
    xmlns:workflows="clr-namespace:Fantoche.App.Features.Workflows"
    Width="1200"
    Height="800"
    d:DataContext="{d:DesignInstance Type=local:SpineViewModel}"
    AllowContentOverTitleBar="True"
    mc:Ignorable="d">
    <controls:ThemedWindow.TitleBarContent>
        <Button
            HorizontalAlignment="Right"
            joolkit:Sizing.IsSquare="True"
            joolkit:Sizing.Size="sm"
            Command="{Binding OpenSettingsCommand}"
            Style="{StaticResource GhostButton}"
            ToolTip="Settings">
            <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Settings}" />
        </Button>
    </controls:ThemedWindow.TitleBarContent>
    <jeedback:ToastContainer Toasts="{Binding Toasts}">
        <javigation:OverlayContainer Overlays="{Binding Overlayer}">
            <DockPanel>
                <nav:NavigationMenu DockPanel.Dock="Left" Navigator="{Binding Navigator}">
                    <nav:NavigationMenu.Header>
                        <StackPanel
                            VerticalAlignment="Center"
                            joolkit:Spacing.Gap="8"
                            Orientation="Horizontal">
                            <fonts:FontIcon FontSize="20" Text="{x:Static fonts:LucideFontIcons.Workflow}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="Automation" />
                        </StackPanel>
                    </nav:NavigationMenu.Header>

                    <nav:NavigationItem TargetType="{x:Type workflows:WorkflowsViewModel}">
                        <nav:NavigationItem.Icon>
                            <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Boxes}" />
                        </nav:NavigationItem.Icon>
                        Workflows / tasks
                    </nav:NavigationItem>
                    <nav:NavigationItem TargetType="{x:Type packages:PackagesViewModel}">
                        <nav:NavigationItem.Icon>
                            <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Package}" />
                        </nav:NavigationItem.Icon>
                        Packages
                    </nav:NavigationItem>
                    <nav:NavigationItem TargetType="{x:Type scheduler:SchedulerViewModel}">
                        <nav:NavigationItem.Icon>
                            <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.CalendarClock}" />
                        </nav:NavigationItem.Icon>
                        Scheduler
                    </nav:NavigationItem>
                    <nav:NavigationItem TargetType="{x:Type workers:WorkersViewModel}">
                        <nav:NavigationItem.Icon>
                            <fonts:FontIcon Text="{x:Static fonts:LucideFontIcons.Cpu}" />
                        </nav:NavigationItem.Icon>
                        Workers
                    </nav:NavigationItem>
                </nav:NavigationMenu>

                <!--  A page that validates itself (INotifyDataErrorInfo) would otherwise put the whole host in error.  -->
                <ContentControl Content="{Binding Navigator.CurrentPage, ValidatesOnNotifyDataErrors=False}" />
            </DockPanel>
        </javigation:OverlayContainer>
    </jeedback:ToastContainer>
</controls:ThemedWindow>
