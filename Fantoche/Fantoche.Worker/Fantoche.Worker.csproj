  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fantoche.Plugins.Shared\Fantoche.Plugins.Shared.csproj" />
    <ProjectReference Include="..\Fantoche.Shared\Fantoche.Shared.csproj" />
  </ItemGroup>

</Project>
