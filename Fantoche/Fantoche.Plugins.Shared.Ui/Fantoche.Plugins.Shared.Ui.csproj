<Project Sdk="Microsoft.NET.Sdk">

  <!--
    What the interface of a task implements : WPF, so Windows only, apart from Fantoche.Plugins.Shared
    which the workers load on any system. Loaded by the application itself : an interface package
    finds it there rather than packing its own copy (see TaskInterfaces in Fantoche.App).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fantoche.Plugins.Shared\Fantoche.Plugins.Shared.csproj" />
  </ItemGroup>

</Project>
