<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The tasks the tests of the engine build their workflows with : they only exercise the engine
    (values, delays, gates, a page), so they ship with no package. See Fantoche.Plugins.Example for
    the tasks of a practical workflow.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fantoche.Plugins.Shared\Fantoche.Plugins.Shared.csproj" />
  </ItemGroup>

  <!-- The page of the reorder task, next to the assembly it is read relative to (see IUserInterfaceTask.PageFolder). -->
  <ItemGroup>
    <Content Include="UserInterfaces\**\*" Exclude="UserInterfaces\**\*.cs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
