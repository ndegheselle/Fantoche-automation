<UserControl
    x:Class="Fantoche.Plugins.Example.Ui.Tables.MapColumnsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Fantoche.Plugins.Example.Ui.Tables"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    d:DataContext="{d:DesignInstance Type=local:MapColumnsViewModel}"
    mc:Ignorable="d">
    <!--
        Plain WPF controls : the application styles them with its theme. Its resources stay here, never
        in the application, where they would apply to every interface.
    -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="18" Text="{Binding Title}" />
        <TextBlock
            Grid.Row="1"
            Margin="0,0,0,8"
            Style="{StaticResource Muted}"
            Text="Pick the column of the file each name stands for, name the other columns you need, then confirm."
            TextWrapping="Wrap" />
        <TextBlock
            Grid.Row="2"
            Margin="0,0,0,8"
            Foreground="IndianRed"
            Text="{Binding Error}"
            TextWrapping="Wrap" />

        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="16" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!--  The names of the workflow, each given a column of the file  -->
            <StackPanel Grid.IsSharedSizeScope="True">
                <TextBlock Style="{StaticResource Heading}" Text="Names of the workflow" />
                <ItemsControl ItemsSource="{Binding Expected}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:NamedColumn}">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" SharedSizeGroup="Name" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Text="{Binding Name}" />
                                <ComboBox
                                    Grid.Column="1"
                                    ItemsSource="{Binding DataContext.StoredColumns, ElementName=Root}"
                                    SelectedItem="{Binding Column, Mode=TwoWay}" />
                                <TextBlock
                                    Grid.Column="2"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource Muted}"
                                    Text="{Binding Sample}" />
                                <TextBlock
                                    Grid.Column="2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Foreground="IndianRed"
                                    Text="Pick a column"
                                    Visibility="{Binding IsMissing, Converter={StaticResource Visible}}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!--  The columns no name picked, named if they need to be  -->
            <StackPanel Grid.Column="2" Grid.IsSharedSizeScope="True">
                <TextBlock Style="{StaticResource Heading}" Text="Other columns, read under their own name unless named" />
                <ItemsControl ItemsSource="{Binding Others}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:OtherColumn}">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" SharedSizeGroup="Column" />
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Text="{Binding Column}" />
                                <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Grid.Column="2"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource Muted}"
                                    Text="{Binding Sample}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>

        <!--  The first rows, as the names read them  -->
        <DataGrid
            Grid.Row="4"
            AutoGeneratingColumn="OnAutoGeneratingColumn"
            CanUserAddRows="False"
            IsReadOnly="True"
            ItemsSource="{Binding Preview}" />

        <TextBlock
            Grid.Row="5"
            Margin="0,4,0,0"
            Style="{StaticResource Muted}"
            Text="{Binding Summary}" />
    </Grid>
</UserControl>
