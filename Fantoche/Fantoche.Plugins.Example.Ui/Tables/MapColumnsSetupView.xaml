<UserControl
    x:Class="Fantoche.Plugins.Example.Ui.Tables.MapColumnsSetupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:jonts="clr-namespace:Joufflu.Assets.Fonts;assembly=Joufflu"
    xmlns:joolkit="clr-namespace:Joufflu.Toolkit;assembly=Joufflu"
    xmlns:joufflu="clr-namespace:Joufflu;assembly=Joufflu"
    xmlns:local="clr-namespace:Fantoche.Plugins.Example.Ui.Tables"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    d:DataContext="{d:DesignInstance Type=local:MapColumnsSetupViewModel}"
    mc:Ignorable="d">
    <!--
        Joufflu, shared with the application : its controls, styles and brushes follow the theme of the
        application. The resources of the view stay here, never in the application, where they would
        apply to every interface.
    -->
    <UserControl.Resources>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Opacity" Value="{DynamicResource {x:Static joufflu:Colors.MutedOpacity}}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid joolkit:Spacing.Gap="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel joolkit:Spacing.Gap="2">
            <StackPanel joolkit:Spacing.Gap="4" Orientation="Horizontal">
                <jonts:FontIcon VerticalAlignment="Center" Text="{x:Static jonts:LucideFontIcons.Table}" />
                <TextBlock
                    VerticalAlignment="Center"
                    joolkit:Sizing.Size="lg"
                    Text="Names of the workflow" />
            </StackPanel>
            <TextBlock Style="{StaticResource Muted}" Text="The nodes after read the columns by these names, whatever the file calls them. The table is only read in a run, where the column of each name is picked : the expected column is where it starts from, the one whose name looks the most alike when left empty." />
        </StackPanel>

        <!--  The table to name the columns of  -->
        <Grid Grid.Row="1" joolkit:Spacing.Gap="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="Table" />
            <!--  Editable : a reference can go deeper than what the node reads offers.  -->
            <ComboBox
                Grid.Column="1"
                IsEditable="True"
                ItemsSource="{Binding SourceReferences}"
                Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Card}">
            <DockPanel Grid.IsSharedSizeScope="True">
                <Grid
                    Margin="0,0,0,4"
                    joolkit:Spacing.Gap="8"
                    DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <!--  As wide as the buttons ending the rows, keeping the headers above their fields.  -->
                        <ColumnDefinition Width="auto" SharedSizeGroup="Remove" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontWeight="SemiBold" Text="Name" />
                    <TextBlock
                        Grid.Column="1"
                        FontWeight="SemiBold"
                        Text="Expected column" />
                </Grid>

                <Button
                    Margin="0,4,0,0"
                    HorizontalAlignment="Left"
                    joolkit:Sizing.Size="sm"
                    Command="{Binding AddNameCommand}"
                    DockPanel.Dock="Bottom"
                    Style="{StaticResource GhostButton}">
                    <StackPanel joolkit:Spacing.Gap="4" Orientation="Horizontal">
                        <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Plus}" />
                        <TextBlock>Add a name</TextBlock>
                    </StackPanel>
                </Button>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Names}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ExpectedName}">
                                <Grid Margin="0,0,0,4" joolkit:Spacing.Gap="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="auto" SharedSizeGroup="Remove" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="The name the nodes after read the column by" />
                                    <TextBox
                                        Grid.Column="1"
                                        Text="{Binding Column, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTip="The column of the file it is expected to stand for, if known" />
                                    <Button
                                        Grid.Column="2"
                                        joolkit:Sizing.IsSquare="True"
                                        joolkit:Sizing.Size="sm"
                                        Command="{Binding DataContext.RemoveNameCommand, ElementName=Root}"
                                        CommandParameter="{Binding}"
                                        Style="{StaticResource GhostButton}"
                                        ToolTip="Remove the name">
                                        <jonts:FontIcon Text="{x:Static jonts:LucideFontIcons.Trash}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
